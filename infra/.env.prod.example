# RailTech Platform — переменные прода (M5-INF-01). Шаблон для /opt/rt/.env.prod (VPS 1) и, частично, /opt/rt-db/.env.db (VPS 2).
#   infra/deploy/make-env-prod.sh init        создаёт /opt/rt/.env.prod (chmod 600), каждое CHANGE_ME заменяет случайным значением
#   infra/deploy/make-env-prod.sh extract-db  печатает часть для VPS 2 (.env.db)
# Читают: infra/compose/base.yml + prod.yml (VPS 1), infra/compose/db.yml, infra/deploy/*.sh, infra/db/*.sh.
# Значение CHANGE_ME = секрет (генерирует make-env-prod.sh); 192.0.2.x = адрес-заглушка, впишите вручную.
# Скрипты деплоя отказываются работать, пока в файле есть CHANGE_ME или 192.0.2.x. Реальные значения — только на серверах,
# в репозиторий не попадают (ORCHESTRATOR §3.6). Тег образов RT_IMAGE_TAG задаёт deploy.sh, в файле его нет.

# --- Раскладка серверов ------------------------------------------------------------------------------
# Внутренние адреса приватной сети провайдера: APP — VPS 1 (приложения), DB — VPS 2 (PostgreSQL). Впишите вручную.
APP_INTERNAL_IP=192.0.2.10
DB_INTERNAL_IP=192.0.2.20
# Каталог файлов БД-сервера на VPS 2 (certs/, pg_hba.conf, .env.db) и каталог локальных бэкапов на VPS 2.
RT_DB_DIR=/opt/rt-db
RT_BACKUP_DIR=/var/backups/rt
# Реестр образов (ghcr.io/<владелец>); пусто/не задано — ghcr.io/nzulkaynarov.
# RT_IMAGE_REGISTRY=ghcr.io/nzulkaynarov
# Профили compose через запятую: mcp (erp-mcp, 256 МБ), observability (clickhouse, langfuse), kb-ingest (docling).
# mcp включён всегда: бот в сервисном режиме (M3-CRM-07: «где мой счёт», «когда поставка», цена клиенту) берёт данные
# из erp-mcp; без него бот отвечает «не могу проверить» и передаёт менеджеру. observability и kb-ingest вместе
# в 8 ГБ не помещаются (servers.md) — добавляйте по очереди: RT_PROFILES=mcp,observability.
RT_PROFILES=mcp

# --- Домены и ACME (Caddy) ---------------------------------------------------------------------------
CRM_DOMAIN=crm.railtech.uz
ERP_DOMAIN=erp.railtech.uz
CABINET_DOMAIN=cabinet.railtech.uz
# Адрес для уведомлений Let's Encrypt. Впишите вручную.
ACME_EMAIL=admin@example.com

# --- Приложение --------------------------------------------------------------------------------------
LOG_LEVEL=INFO
# json (для docker logs / Loki) | console
LOG_FORMAT=json
READY_CHECK_TIMEOUT_S=2

# --- PostgreSQL на VPS 2: пароли ролей (infra/db/prod-init.sh создаёт роли crm_app, erp_app, litellm_app, langfuse_app) ---
DB_CRM_PASSWORD=CHANGE_ME
DB_ERP_PASSWORD=CHANGE_ME
DB_LITELLM_PASSWORD=CHANGE_ME
DB_LANGFUSE_PASSWORD=CHANGE_ME
# Только VPS 2: суперпользователь и роль бэкапа (drop-db-only убирает их с VPS 1).
DB_SUPERUSER_PASSWORD=CHANGE_ME
DB_BACKUP_PASSWORD=CHANGE_ME

# --- Локальный PostgreSQL base.yml (профиль local-db, на проде не стартует) -----------------------------
# compose всё равно требует значения при разборе файла, поэтому переменные заданы; на проде база — на VPS 2.
POSTGRES_USER=rt
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis (0 — Langfuse, 1 — ERP Celery, 2 — ERP Channels) -------------------------------------------
REDIS_PASSWORD=CHANGE_ME

# --- S3: RustFS на VPS 1 (бакеты создаёт s3-init) ---------------------------------------------------
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# --- Бэкап БД (VPS 2, infra/db/backup.sh) ------------------------------------------------------------
BACKUP_KEEP_DAYS=14
# Время ежедневного бэкапа, UTC.
BACKUP_AT_UTC=22:00
# Ежедневно — в бакет backups RustFS на VPS 1 (http://<APP_INTERNAL_IP>:9000). Ключи — те же, что S3_*: init подставляет сам.
BACKUP_RUSTFS_ENDPOINT=http://192.0.2.10:9000
BACKUP_RUSTFS_ACCESS_KEY=
BACKUP_RUSTFS_SECRET_KEY=
BACKUP_RUSTFS_BUCKET=backups
# Еженедельно — во внешнее S3-совместимое хранилище, шифруется BACKUP_ENC_PASSPHRASE (AES-256). Провайдера выбирает владелец.
# Пусто — выгрузка выключена. BACKUP_ENC_PASSPHRASE хранить офлайн: потеря = потеря внешних копий.
BACKUP_EXT_ENDPOINT=
BACKUP_EXT_ACCESS_KEY=
BACKUP_EXT_SECRET_KEY=
BACKUP_EXT_BUCKET=
BACKUP_EXT_REGION=
# День недели выгрузки (0 — воскресенье) и срок хранения внешних копий, дней.
BACKUP_EXT_DAY=0
BACKUP_EXT_KEEP_DAYS=60
BACKUP_ENC_PASSPHRASE=CHANGE_ME

# --- LiteLLM — единственный шлюз к моделям (ADR-0005) -------------------------------------------------
# Должны начинаться с "sk-".
LITELLM_MASTER_KEY=sk-CHANGE_ME
# Ключ шифрования ключей провайдеров в БД LiteLLM. НЕ МЕНЯТЬ после первого запуска; хранить офлайн.
LITELLM_SALT_KEY=sk-CHANGE_ME
# Ключи провайдеров по умолчанию — вписать вручную. Ключ из консоли админа CRM имеет приоритет.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- docling-serve (профиль kb-ingest) ------------------------------------------------------------
DOCLING_API_KEY=CHANGE_ME

# --- CRM -------------------------------------------------------------------------------------------
# Ключ подписи access-JWT CRM (HS256, >= 32 байт). Смена разлогинивает всех.
CRM_JWT_SECRET=CHANGE_ME
# Ключ шифрования секретов интеграций в БД CRM (Fernet). Потеря = ввод токенов заново.
CRM_SECRETS_KEY=CHANGE_ME
# HMAC-ключ контекста вызова MCP-инструментов агентов CRM.
CRM_AGENT_CONTEXT_KEY=CHANGE_ME
# Ключи проекта Langfuse для трейсов CRM (создать в Langfuse после первого входа). Пусто — трейсов нет.
CRM_LANGFUSE_PUBLIC_KEY=
CRM_LANGFUSE_SECRET_KEY=

# --- Telegram: один клиентский бот, принадлежит CRM -----------------------------------------------------
# Токен от @BotFather. Вписать вручную. Пусто — бот не запускается.
TELEGRAM_BOT_TOKEN=
# Имя бота без @ (не секрет): ссылки t.me/<бот> в Cabinet. Пусто — кнопки скрыты.
TELEGRAM_BOT_USERNAME=
# На проде — webhook (Caddy отдаёт /telegram/webhook на домене CRM); polling | webhook | disabled.
TELEGRAM_MODE=webhook
# Публичный URL вебхука: https://<CRM_DOMAIN>/telegram/webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME

# --- Cabinet ↔ CRM ------------------------------------------------------------------------------------
# Lax — веб Cabinet; None — Telegram Mini App (cookie Secure, только за TLS).
PORTAL_COOKIE_SAMESITE=Lax

# --- Шов CRM ↔ ERP (CONTRACTS §0, §3, §5, §6) ------------------------------------------------------------
# Два активных значения через запятую — ротация без простоя.
SERVICE_TOKEN_CRM_TO_ERP=CHANGE_ME
SERVICE_TOKEN_ERP_TO_CRM=CHANGE_ME
# HMAC вебхуков ERP -> CRM: ERP подписывает этим секретом.
WEBHOOK_SECRET=CHANGE_ME
# Ротация без простоя (docs/runbooks/webhooks.md): пусто в обычное время; на время смены — прежний секрет.
# В CRM («Подключения» -> ERP) вводятся оба (новый текущий + прежний предыдущий), затем предыдущий снимается.
WEBHOOK_SECRET_PREVIOUS=
# Общий секрет SSO-токена сотрудника (packages/contracts/sso-token.md).
PLATFORM_SSO_SECRET=CHANGE_ME
# Переход сотрудника CRM <-> ERP без пароля: true/false. Включать только после FIX-10 и FIX-11.
PLATFORM_SSO_ENABLED=false
# HMAC контекста X-Agent-Context для erp-mcp: им CRM подписывает вызовы бота, а erp-mcp проверяет. Один ключ на обе
# стороны. ERP_MCP_ENABLED=false (по умолчанию true) выключает ходы бота к ERP, не трогая сам erp-mcp.
ERP_MCP_CONTEXT_KEY=CHANGE_ME
# ERP_MCP_ENABLED=true

# --- ERP -----------------------------------------------------------------------------------------------
# Django SECRET_KEY ERP.
ERP_SECRET_KEY=CHANGE_ME
# На проде всегда false.
ERP_DEBUG=false
# Почта ERP: SMTP-релей (SMTP_* ниже вписать вручную).
ERP_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Id компании-владельца ERP (core.tenant): на проде обязателен — вписать после создания компании (FIX-11, runbook deploy.md).
OWN_COMPANY_ID=
SUPPORT_EMAIL=support@example.com
# ИИ ERP: включён ли разбор через LiteLLM и дневной бюджет, USD (0 — без лимита).
ERP_AI_ENABLED=true
ERP_AI_DAILY_BUDGET_USD=1
# Виртуальный ключ ERP в LiteLLM (регистрирует erp-ai-gateway; "sk-").
ERP_LITELLM_API_KEY=sk-CHANGE_ME
# Ключи проекта Langfuse для трейсов ERP. Пусто — берутся CRM_LANGFUSE_*.
ERP_LANGFUSE_PUBLIC_KEY=
ERP_LANGFUSE_SECRET_KEY=

# --- SMTP (письма ERP) — вписать вручную ----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_FROM=noreply@example.com

# --- Langfuse (профиль observability; открывается SSH-туннелем, runbook deploy.md) ---------------------
LANGFUSE_URL=http://localhost:3000
LANGFUSE_S3_PUBLIC_ENDPOINT=http://localhost:9000
# openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME
LANGFUSE_SALT=CHANGE_ME
# Ровно 64 hex-символа (openssl rand -hex 32).
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME
CLICKHOUSE_PASSWORD=CHANGE_ME
