# dev: три домена ансамбля на *.localhost без TLS (ARCHITECTURE §10). Браузеры резолвят *.localhost
# в 127.0.0.1 сами; для curl — `--resolve crm.localhost:80:127.0.0.1` или запись в /etc/hosts.
# prod-вариант с ACME и security headers — infra/caddy/Caddyfile.prod (M5-INF-01).
{
	auto_https off
}

# ─── CRM — фронт-офис (apps/crm) ───────────────────────────────────────────────────────────
http://crm.localhost {
	handle /api/* {
		reverse_proxy crm-api:8000
	}
	handle /telegram/webhook {
		reverse_proxy crm-api:8000
	}
	handle /health {
		reverse_proxy crm-api:8000
	}
	handle /ready {
		reverse_proxy crm-api:8000
	}
	handle {
		reverse_proxy crm-web:5173
	}
}

# ─── ERP — бэк-офис (apps/erp; копия B2B с M1-ERP-01) ────────────────────────────────────
http://erp.localhost {
	# erp-mcp — отдельный процесс, только для агента CRM внутри сети (crm-* → http://erp-mcp:8104/mcp/erp), наружу не
	# публикуется: иначе контекст агента подбирают снаружи (FIX-03, аудит S-9). 404, а не SPA.
	@mcp path /mcp /mcp/*
	handle @mcp {
		respond 404
	}
	@backend path /api/* /admin/* /admin /ws/* /static/* /media/* /health /health/
	handle @backend {
		reverse_proxy erp-backend:8000
	}
	handle {
		reverse_proxy erp-web:80
	}
}

# ─── Cabinet — кабинет клиента (apps/cabinet, M2-CAB-01) ───────────────────────────────────
# SPA без бэкенда (ADR-0004): портальный API ERP отдаётся с того же домена, поэтому cookie сессии
# портала same-origin и CORS не нужен. До M2-ERP-01 /api/portal/* отвечает 404 — ожидаемо.
# /media/*: картинки каталога — абсолютные ссылки на этот же домен (`catalog/published.py`); Django ERP отдаёт только
# публичные пути media (`core/urls.py`, allowlist), остальное — 404, как на erp.* (FIX-54, P-18).
http://cabinet.localhost {
	handle /api/portal/* {
		reverse_proxy erp-backend:8000
	}
	handle /media/* {
		reverse_proxy erp-backend:8000
	}
	handle {
		reverse_proxy cabinet-web:80
	}
}

# ─── Платформа — единое рабочее место сотрудника (apps/platform, INF-P0-4) ─────────────────
# BFF (`platform-bff`) — единственный бэкенд SPA: /api/* уходит туда, остальное — статика `platform-web`.
# Заголовки безопасности и CSP — как у CRM в Caddyfile.prod (HSTS в dev нет: HTTP без TLS); `style-src 'unsafe-inline'`
# нужен Ant Design (CSS-in-JS). Логика и порядок директив — одна с prod; расхождение dev/prod здесь — дефект.
http://platform.localhost {
	# mcp-серверы агентов — только внутри сети compose (FIX-03, аудит S-9); у Платформы их нет, 404 на всякий случай.
	@mcp path /mcp /mcp/*
	handle @mcp {
		respond 404
	}
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}
	handle /api/* {
		reverse_proxy platform-bff:8000 {
			# SSE: без буферизации ответа
			flush_interval -1
		}
	}
	handle {
		reverse_proxy platform-web:8080
	}
}

# ─── Служебные интерфейсы (только dev) ─────────────────────────────────────────────────────
http://langfuse.localhost {
	reverse_proxy langfuse-web:3000
}

http://s3.localhost {
	reverse_proxy rustfs:9001
}
