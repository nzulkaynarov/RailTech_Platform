# prod (M5-INF-01): четыре домена ансамбля (CRM, ERP, Cabinet, Платформа) с TLS (ACME, Let's Encrypt), security headers, маршруты как в
# Caddyfile.dev. Домены и e-mail ACME — переменные окружения контейнера Caddy (infra/compose/prod.yml).
# Служебные интерфейсы Langfuse и консоль RustFS наружу не публикуются (Langfuse — SSH-туннель на 127.0.0.1:3000); Django admin
# ERP — только администратору Платформы на её домене по пути /console/erp/admin/ (сниппет service_consoles, OPS-CONSOLE).

# Журнал доступа и идентификатор запроса (S0-6, ADR-0017): один сниппет на все сайты. Логика и порядок — одна в
# Caddyfile.prod и Caddyfile.dev, расхождение — дефект.
# Журнал: JSON в stdout, по строке на запрос. Секреты вырезаны filter-кодировщиком (`log_credentials` не включаем):
# заголовки аутентификации и подписей удалены, токены в пути и в строке запроса (magic-link портала, публичные ссылки
# на КП и документы, `token=`/`key=`/`signature=`) заменены на REDACTED. Имена заголовков — в каноническом виде Go.
# Тот же фильтр (`log_filter`) стоит на журнале по умолчанию: ошибки проксирования (`http.log.error`, 502/504) печатают заголовки
# запроса целиком, а Caddy маскирует по умолчанию только Cookie и Authorization.
# Сниппет стоит до блока глобальных опций: иначе `import` внутри него не находит сниппет.
(log_filter) {
	format filter {
		wrap json
		request>headers>Authorization delete
		request>headers>Proxy-Authorization delete
		request>headers>Cookie delete
		request>headers>X-Telegram-Bot-Api-Secret-Token delete
		request>headers>X-Signature delete
		request>headers>X-Agent-Context delete
		request>headers>X-Crm-Context delete
		request>headers>X-Pairing-Proof delete
		request>headers>X-Portal-Session delete
		request>headers>X-Api-Key delete
		request>headers>X-Csrftoken delete
		request>uri regexp `(/auth/magic/|/public/(?:quotes|documents|doc-links)/|[?&](?:token|access_token|key|api_key|signature|sig|code|secret)=)[^/?#&\s"']+` `${1}REDACTED`
		request>headers>Referer regexp `(/auth/magic/|/public/(?:quotes|documents|doc-links)/|[?&](?:token|access_token|key|api_key|signature|sig|code|secret)=)[^/?#&\s"']+` `${1}REDACTED`
		resp_headers>Set-Cookie delete
	}
}

{
	email {$ACME_EMAIL}
	log {
		import log_filter
	}
}

(security_headers) {
	header {
		# Без includeSubDomains: на railtech.uz живут и другие поддомены (старый прод b2b.*).
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# mcp-серверы агентов — только внутри сети compose (FIX-03, аудит S-9): снаружи 404 на всех доменах.
(no_mcp) {
	@mcp path /mcp /mcp/*
	handle @mcp {
		respond 404
	}
}

# Приёмник шины rt_bus (/bus/v1/events) — только внутри сети compose (B5): на домене Платформы снаружи 404.
(no_bus) {
	@bus path /bus /bus/*
	handle @bus {
		respond 404
	}
}

# Служебная консоль на домене Платформы (OPS-CONSOLE, DECISIONS 2026-11-03): без новых поддоменов, по пути /console/<ключ>/.
# Сейчас одна — Django admin ERP (/console/erp/admin/). Перед каждым запросом Caddy спрашивает BFF (`forward_auth`,
# GET /api/v1/consoles/<ключ>/auth): 204 — пропустить (сессия Платформы и право `admin: full`), 401 — на экран входа, 403/404 —
# ответ BFF как есть (no-store). Путь уходит в ERP целиком (ERP_CONSOLE_PREFIX=/console/erp, core/console_mount.py); свой вход
# Django admin остаётся. Изоляция cookie: в ERP уходят только `sessionid` и `csrftoken` (cookie Платформы и прочие — нет), а
# cookie консоли ставятся с Path=/console/erp (ERP переписывает сам, Caddy — второй барьер), SPA Платформы их не видит.
# Принятый риск общего origin — DECISIONS 2026-11-03. LiteLLM через Платформу не публикуется: его кука `token` (ключ админа
# шлюза) доступна скриптам на Path=/ — модели и расходы ведутся экранами Платформы. RustFS — без консоли (Q-OPS-CONSOLE-1).
# CSP консоли — только на её пути, остальной сайт не ослаблен. Выключить: PLATFORM_CONSOLES= (пусто) у BFF — 404.
(console_gate) {
	forward_auth platform-bff:8000 {
		uri /api/v1/consoles/{args[0]}/auth
		@console_anon status 401
		handle_response @console_anon {
			header Cache-Control "no-store"
			redir * /login 302
		}
	}
}

(service_consoles) {
	# Django admin ERP: только admin/ и static/ под префиксом (машинный API, шина и портал сюда не попадают).
	@console_erp path /console/erp/admin /console/erp/admin/* /console/erp/static/*
	handle @console_erp {
		import console_gate erp
		# Unfold (Alpine.js) компилирует директивы через new Function() — 'unsafe-eval' только здесь (как core/csp.py ERP).
		header >Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		# Cookie консоли — только под её путём (если ERP уже поставил Path=/console/erp, замена не срабатывает).
		header >Set-Cookie "(?i)(;\s*path=)/(\s*;|\s*$)" "$1/console/erp$2"
		reverse_proxy erp-backend:8000 {
			# В ERP — только cookie Django admin; пустое значение Django считает отсутствующим.
			header_up Cookie "sessionid={http.request.cookie.sessionid}; csrftoken={http.request.cookie.csrftoken}"
		}
	}
	@console_other path /console /console/*
	handle @console_other {
		respond 404
	}
}

(access_log) {
	log {
		output stdout
		import log_filter
	}
}

# X-Request-ID: пришёл от клиента — пропускаем как есть, нет (или пустой) — ставим UUID запроса. Заголовок уходит во все
# апстримы (его читают CRM — asgi-correlation-id, ERP — RequestIDMiddleware), возвращается клиенту (отложенная установка
# `>` заменяет собственный эхо-ответ апстрима, значение одно) и попадает в строку журнала доступа полем `request_id`.
# Поиск запроса по идентификатору в журналах Caddy, CRM и ERP — docs/runbooks/request-id.md.
(request_id) {
	@no_request_id not header_regexp X-Request-ID .+
	request_header @no_request_id X-Request-ID {http.request.uuid}
	header >X-Request-ID {http.request.header.X-Request-ID}
	log_append request_id {http.request.header.X-Request-ID}
}

# ─── CRM — фронт-офис (apps/crm) ───────────────────────────────────────────────────────────
{$CRM_DOMAIN} {
	import access_log
	import request_id
	encode zstd gzip
	import security_headers
	import no_mcp
	# antd (CSS-in-JS) вставляет <style> — 'unsafe-inline' только для стилей.
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

	handle /api/* {
		reverse_proxy crm-api:8000 {
			# SSE (/api/v1/stream): без буферизации ответа
			flush_interval -1
		}
	}
	# Вебхук принимает процесс бота (S0-4), не crm-api; секретный заголовок проверяет он же.
	handle /telegram/webhook {
		reverse_proxy crm-bot:8001
	}
	handle /health {
		reverse_proxy crm-api:8000
	}
	handle /ready {
		reverse_proxy crm-api:8000
	}
	handle {
		reverse_proxy crm-web:8080
	}
}

# Машинный API ERP (/api/integration — вызовы CRM и коннекторов) и Django admin (/admin) — только внутри сети compose
# (`http://erp-backend:8000`), снаружи 404 на всех доменах (S0-5); так же приёмник шины rt_bus `/bus/v1/events` (B3). Матчер — по префиксу пути `/admin`: `/api/v1/admin/...`
# (API шаблонов писем и др.) не затрагивается. Администратору в Django admin — /console/erp/admin/ на домене Платформы (service_consoles) или SSH-туннель.
(no_erp_internal) {
	@erp_internal path /api/integration /api/integration/* /admin /admin/* /bus /bus/*
	handle @erp_internal {
		respond 404
	}
}

# ─── ERP — бэк-офис (apps/erp) ─────────────────────────────────────────────────────────────
{$ERP_DOMAIN} {
	import access_log
	import request_id
	encode zstd gzip
	import security_headers
	import no_mcp
	import no_erp_internal
	@backend path /api/* /ws/* /static/* /media/* /health /health/
	handle @backend {
		reverse_proxy erp-backend:8000
	}
	handle {
		reverse_proxy erp-web:80
	}
}

# ─── Cabinet — кабинет клиента (apps/cabinet) ──────────────────────────────────────────────
# SPA без бэкенда (ADR-0004): портальный API ERP отдаётся с того же домена — cookie same-origin, CORS не нужен.
# /media/*: картинки каталога — абсолютные ссылки на этот же домен (`catalog/published.py`); Django ERP отдаёт только
# публичные пути media (`core/urls.py`, allowlist), остальное — 404, как на ERP-домене (FIX-54, P-18).
{$CABINET_DOMAIN} {
	import access_log
	import request_id
	encode zstd gzip
	import security_headers
	import no_mcp
	handle /api/portal/* {
		reverse_proxy erp-backend:8000
	}
	handle /media/* {
		reverse_proxy erp-backend:8000
	}
	handle {
		reverse_proxy cabinet-web:80
	}
}

# ─── Платформа — единое рабочее место сотрудника (apps/platform, INF-P0-5) ──────────────────
# BFF (`platform-bff`) — единственный бэкенд SPA: /api/* уходит туда, остальное — статика `platform-web` (file-server Caddy
# на :8080). CSP и заголовки — как у CRM; `style-src 'unsafe-inline'` нужен Ant Design (CSS-in-JS). Дев-аналог — Caddyfile.dev.
{$PLATFORM_DOMAIN} {
	import access_log
	import request_id
	encode zstd gzip
	import security_headers
	import no_mcp
	import no_bus
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

	import service_consoles
	handle /api/v1/me/avatar {
		# Фото профиля (W15-H6): тело больше 1 МБ с запасом на multipart отсекается до BFF
		request_body {
			max_size 1200KB
		}
		reverse_proxy platform-bff:8000
	}
	handle /api/* {
		reverse_proxy platform-bff:8000 {
			# SSE (/api/v1/events/stream): без буферизации ответа
			flush_interval -1
		}
	}
	handle {
		reverse_proxy platform-web:8080
	}
}
