<!--
  ClickHouse for Langfuse on a small VPS: Langfuse needs only its own tables. The server's own diagnostic logs
  (sampling profiler trace_log, text_log, metric logs, part_log …) kept ~1.5 vCPU busy on an idle prod
  (2026-11-13: trace_log 5.5 M rows, text_log 2.7 M). query_log stays (small, useful for slow Langfuse queries)
  with a 7-day TTL. Removing a section that this version does not have is harmless.
-->
<clickhouse>
    <logger>
        <level>warning</level>
    </logger>

    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <histogram_metric_log remove="1"/>
    <query_metric_log remove="1"/>
    <part_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <error_log remove="1"/>
    <latency_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <session_log remove="1"/>
    <blob_storage_log remove="1"/>
    <background_schedule_pool_log remove="1"/>

    <query_log replace="1">
        <database>system</database>
        <table>query_log</table>
        <engine>ENGINE = MergeTree PARTITION BY event_date ORDER BY event_time TTL event_date + INTERVAL 7 DAY</engine>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </query_log>
</clickhouse>
