{"nodes": [{"id": "docs_dev_ops_merge_without_ci_protocol", "label": "Merge-without-CI protocol", "file_type": "document", "source_file": "Docs/dev/ops/merge-without-ci.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner decision 2026-08-17: don't pay GitHub Actions billing; ci.yml jobs 'fail' in 2s with zero steps; self-hosted deploy runner works (~55 min); no branch protection on main so discipline rests on this protocol"}, {"id": "docs_dev_ops_merge_without_ci_make_ci_local", "label": "make ci-local (scripts/ci_local.sh) \u2014 mirror of 11 ci.yml jobs", "file_type": "concept", "source_file": "Docs/dev/ops/merge-without-ci.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Steps don't abort each other; report table .ci-local/report.md pasted into PR body replaces check-runs as evidence; SKIP=/ONLY= to split expensive network steps; all 11 green in ONE commit"}, {"id": "docs_dev_ops_merge_without_ci_ci_dead_diagnosis", "label": "Diagnosis: CI dead vs PR red (gh run view steps|length == 0)", "file_type": "concept", "source_file": "Docs/dev/ops/merge-without-ci.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_dev_ops_merge_without_ci_deps_lock_false_ok_trap", "label": "deps-lock false-OK trap", "file_type": "rationale", "source_file": "Docs/dev/ops/merge-without-ci.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If pip-compile fails (network), lock files aren't rewritten \u2192 git diff empty \u2192 'no drift'. Script checks container exit code (set -e), mtime of both locks newer than step start, and git diff"}, {"id": "docs_dev_ops_merge_without_ci_docker_desktop_egress_trap", "label": "Docker Desktop macOS egress rot trap", "file_type": "rationale", "source_file": "Docs/dev/ops/merge-without-ci.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VM egress dies minutes after start (context deadline exceeded); only pkill -9 -f com.docker; open -a Docker helps; run network steps right after restart"}, {"id": "docs_dev_ops_merge_without_ci_fresh_image_tests", "label": "Tests run in container from FRESH image (docker-build before backend-test)", "file_type": "rationale", "source_file": "Docs/dev/ops/merge-without-ci.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Otherwise lock changes are tested against yesterday's dependency set"}, {"id": "docs_dev_ops_merge_without_ci_prod_check_outside", "label": "Prod check from outside (bundle hash, /health/, dep versions via docker exec)", "file_type": "concept", "source_file": "Docs/dev/ops/merge-without-ci.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_dev_ops_merge_without_ci_deploy_not_started", "label": "Runbook: if self-hosted deploy didn't start", "file_type": "concept", "source_file": "Docs/dev/ops/merge-without-ci.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manual deploy on VPS needs .env rendered from GitHub secrets \u2014 not on disk, so requires the owner"}], "edges": [{"source": "docs_dev_ops_merge_without_ci_protocol", "target": "docs_dev_ops_merge_without_ci_make_ci_local", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Docs/dev/ops/merge-without-ci.md", "source_location": null, "weight": 1.0}, {"source": "docs_dev_ops_merge_without_ci_protocol", "target": "docs_dev_ops_merge_without_ci_ci_dead_diagnosis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Docs/dev/ops/merge-without-ci.md", "source_location