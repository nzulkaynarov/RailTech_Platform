{"nodes": [{"id": "_github_workflows_apply_caddy_applycaddyworkflow", "label": "Apply Caddy config workflow (manual dispatch)", "file_type": "code", "source_file": ".github/workflows/apply-caddy.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_apply_caddy_manual_confirm_gate", "label": "Manual-only APPLY confirmation gate for shared edge", "file_type": "rationale", "rationale": "The edge is shared with the neighbouring site grades.railtech.uz on the same Caddy \u2014 a broken fragment kills TLS for the whole box, not just this project, so apply is a separate workflow, manual-only with a typed APPLY confirmation, never automatic on merge; the app deploy must also never be hostage to edge config and vice versa.", "source_file": ".github/workflows/apply-caddy.yml", "source_location": "lines 1-29", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_apply_caddy_backup_validate_rollback", "label": "Backup \u2192 validate whole master \u2192 reload \u2192 verify both sites \u2192 rollback procedure", "file_type": "rationale", "rationale": "Self-insuring apply procedure: backup live fragment, copy repo fragment, validate the ENTIRE master Caddyfile (it imports the neighbour, so a neighbour error must also stop the apply), reload, then verify our site returns 200 with Cache-Control and the neighbour is not connection-refused (000 = we dropped its TLS); any failure restores the backup and reloads again. Backup uses a .bak extension deliberately so the conf.d/*.caddy import cannot pick it up as a second site.", "source_file": ".github/workflows/apply-caddy.yml", "source_location": "lines 61-128", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_github_workflows_apply_caddy_applycaddyworkflow", "target": "_github_workflows_apply_caddy_manual_confirm_gate", "relation": "implements", "con