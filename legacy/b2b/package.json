{
  "private": true,
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.0",
    "lint-staged": "^15.4.0"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx}": [
      "bash -c 'cd frontend && npx eslint --fix --no-warn-ignored'"
    ],
    "frontend/src/i18n/locales/*.json": [
      "bash -c 'python3 scripts/check_i18n_symmetry.py'"
    ]
  }
}
