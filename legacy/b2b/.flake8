[flake8]
max-line-length = 120
exclude =
    migrations,
    venv,
    __pycache__,
    .git,
    .env,
    .venv,
    node_modules,
    frontend
# extend-ignore preserves flake8's default ignores (E121,E123,E126,E226,E24,
# E704,W503,W504) — these conflict with black. Using bare `ignore` would
# re-enable them, surfacing e.g. E226 inside f-strings on Python 3.12+.
extend-ignore =
    E203,
    E226,
    E501,
    W503
