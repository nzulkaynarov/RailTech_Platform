# ==============================================================================
# RailTech B2B — PRODUCTION .env for b2b.railtech.uz
# Copy to the deploy dir as `.env` on the VPS and fill every <PLACEHOLDER>.
# NEVER commit the filled file. Generate secrets on the server.
#
#   DJANGO_SECRET_KEY:  python3 -c "import secrets;print(secrets.token_urlsafe(64))"
#   MINIO_SECRET_KEY:   openssl rand -base64 32
#   SUPERADMIN_PASSWORD: openssl rand -base64 24
# ==============================================================================

# ── Core Django ──────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=<GENERATE_64_CHAR_SECRET>
DJANGO_DEBUG=False
# Enables secure cookies + SECURE_PROXY_SSL_HEADER (Caddy sends X-Forwarded-Proto).
PRODUCTION=true
ALLOWED_HOSTS=b2b.railtech.uz
# Caddy already does HTTP->HTTPS redirect + HSTS, so leave Django's redirect OFF
# (prevents any redirect loop behind the proxy). Do NOT set SECURE_SSL_REDIRECT=true.

# ── Database (Neon Cloud, external) ──────────────────────────────────────────
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<NEON_HOST>/<DB>?sslmode=require&channel_binding=require
DB_SSLMODE=require

# ── Redis (internal Docker network — service names, container port 6379) ─────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis-celery:6379/0
CELERY_RESULT_BACKEND=redis://redis-celery:6379/0

# ── MinIO (internal only; not exposed publicly) ─────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=railtech-b2b
MINIO_SECRET_KEY=<GENERATE_STRONG_SECRET>
MINIO_PUBLIC_BUCKET=railtech-public
MINIO_PRIVATE_BUCKET=railtech-private
MINIO_TEMP_BUCKET=railtech-temp
# Public file URLs: MinIO is not internet-facing. Until a files route/subdomain is
# added, public assets are reachable via the backend /media path (Caddy -> backend).
MINIO_EXTERNAL_ENDPOINT=https://b2b.railtech.uz
MINIO_PUBLIC_DOMAIN=

# ── Frontend build args (relative = same-origin via Caddy) ───────────────────
VITE_API_URL=/api
VITE_WS_URL=/ws
FRONTEND_URL=https://b2b.railtech.uz

# ── Superadmin (created via `manage.py init_superadmin`) ─────────────────────
SUPERADMIN_EMAIL=admin@railtech.uz
SUPERADMIN_PASSWORD=<GENERATE_STRONG_PASSWORD>

# ── Email / SMTP (transactional: registration, KYC, invites) ─────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=<SMTP_HOST>
EMAIL_PORT=587
EMAIL_HOST_USER=<SMTP_USER>
EMAIL_HOST_PASSWORD=<SMTP_PASSWORD>
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@railtech.uz

# ── Logging ──────────────────────────────────────────────────────────────────
DJANGO_LOG_LEVEL=INFO
