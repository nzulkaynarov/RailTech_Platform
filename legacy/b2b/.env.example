# ==============================================================================
# RailTech B2B Ecosystem — Master Environment Configuration
# Скопируй этот файл в .env и заполни все значения перед запуском.
# НИКОГДА не коммить .env с реальными секретами в Git.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. DATABASE (выбери один из двух вариантов)
# ------------------------------------------------------------------------------

# Вариант A: Единый DATABASE_URL (Neon Cloud / любой managed PostgreSQL)
# Если задан — POSTGRES_* переменные ниже игнорируются в settings.py
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# Вариант B: Локальный Docker PostgreSQL (используется если DATABASE_URL не задан)
POSTGRES_DB=railtech
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432


# ------------------------------------------------------------------------------
# 2. DJANGO CORE
# ------------------------------------------------------------------------------

# Генерировать командой: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME_generate-a-secure-50-char-secret-key

# False в production ОБЯЗАТЕЛЬНО
DJANGO_DEBUG=False

DJANGO_LOG_LEVEL=INFO

# Все домены через запятую БЕЗ пробелов
ALLOWED_HOSTS=localhost,127.0.0.1,railtech.uz,b2b.railtech.uz,cabinet.railtech.uz,crm.railtech.uz,admin.railtech.uz


# ------------------------------------------------------------------------------
# 3. CORS & CSRF
# ------------------------------------------------------------------------------

# Источники, которым разрешён доступ к API (фронтенд-домены)
CORS_ALLOWED_ORIGINS=https://railtech.uz,https://b2b.railtech.uz,https://cabinet.railtech.uz,https://crm.railtech.uz

# Для локальной разработки добавь: http://localhost:5173,http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Если фронт и бэк на разных доменах — обязательно True
CORS_ALLOW_CREDENTIALS=True

# CSRF_TRUSTED_ORIGINS нужен при DEBUG=False и использовании admin через HTTPS
CSRF_TRUSTED_ORIGINS=https://railtech.uz,https://admin.railtech.uz,https://crm.railtech.uz


# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION (django-simplejwt)
# ------------------------------------------------------------------------------

# Время жизни access-токена в минутах (30 — разумный минимум для B2B)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30

# Время жизни refresh-токена в днях
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Ротация refresh-токенов: True = при каждом обновлении выдаётся новый refresh
JWT_ROTATE_REFRESH_TOKENS=True


# ------------------------------------------------------------------------------
# 5. REDIS & CELERY
# ------------------------------------------------------------------------------

# Redis DB 0 — зарезервирован под django-channels (WebSocket)
# Redis DB 1 — Celery broker + result backend
# Redis DB 2 — Django cache (если подключишь django.core.cache)

REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# True — задачи выполняются синхронно (для тестов, DEBUG). False в production.
CELERY_TASK_ALWAYS_EAGER=False

# Количество воркеров на один процесс celery worker
# Рекомендация: 2 × CPU_COUNT для IO-bound задач (импорт Excel, PDF)
CELERY_WORKER_CONCURRENCY=4

# Redis authentication (recommended for production)
REDIS_PASSWORD=

# Separate Redis for Celery broker (uses dedicated redis-celery container)
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis-celery:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis-celery:6379/0


# ------------------------------------------------------------------------------
# 6. DJANGO CHANNELS (WebSocket)
# ------------------------------------------------------------------------------

# Отдельная Redis-база для Channel Layer (не смешивать с Celery)
CHANNEL_LAYERS_HOST=redis
CHANNEL_LAYERS_PORT=6379
CHANNEL_LAYERS_DB=0


# ------------------------------------------------------------------------------
# 7. EMAIL (SMTP)
# ------------------------------------------------------------------------------

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@railtech.uz
# Для Gmail — App Password (не основной пароль аккаунта)
EMAIL_HOST_PASSWORD=CHANGE_ME_your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=RailTech Notifications <noreply@railtech.uz>


# ------------------------------------------------------------------------------
# 8. FRONTEND (Vite build-time)
# ------------------------------------------------------------------------------

# URL бэкенда, который Vite вставит в сборку во время docker build
# В production: https://api.railtech.uz или пустая строка (если nginx проксирует /api/)
VITE_API_URL=http://localhost:8000

# WebSocket URL (для ContextualChat / real-time уведомлений)
# В production: wss://crm.railtech.uz/ws
VITE_WS_URL=ws://localhost:8000/ws

# Frontend URL for email links (password setup, invitations, etc.)
FRONTEND_URL=http://localhost:5173


# ------------------------------------------------------------------------------
# 9. STATIC & MEDIA
# ------------------------------------------------------------------------------

# Путь для Django collectstatic (внутри контейнера)
STATIC_ROOT=/app/staticfiles

# Путь для загружаемых файлов (внутри контейнера, fallback когда MinIO не настроен)
MEDIA_ROOT=/app/media


# ------------------------------------------------------------------------------
# 9a. MINIO / S3 OBJECT STORAGE
# ------------------------------------------------------------------------------

# Когда MINIO_ENDPOINT задан — файлы загружаются в MinIO (S3-совместимое хранилище).
# Когда пустой — используется локальная файловая система (MEDIA_ROOT).
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=railtech
MINIO_SECRET_KEY=CHANGE_ME_minio-secret-key

# Бакеты (создаются автоматически при старте minio-init)
# - railtech-public: товары, логотипы, аватары (querystring_auth=False → публичные без подписи)
# - railtech-private: KYC документы, сделки, котировки (querystring_auth=True → с 15-мин подписью)
# - railtech-temp: временные файлы для обработки
MINIO_PUBLIC_BUCKET=railtech-public
MINIO_PRIVATE_BUCKET=railtech-private
MINIO_TEMP_BUCKET=railtech-temp

# Домен для публичных URL (через nginx proxy)
# Локально: localhost/storage | Продакшн: cdn.railtech.uz
# При пустом значении используются relative paths (файлы через бэкенд)
MINIO_PUBLIC_DOMAIN=localhost/storage

# Порт для MinIO Console (веб-интерфейс управления файлами)
MINIO_CONSOLE_PORT=9001


# ------------------------------------------------------------------------------
# 10. PDF GENERATION (WeasyPrint)
# ------------------------------------------------------------------------------

# Базовый URL для разрешения относительных ссылок в PDF (логотипы, стили)
# Обычно совпадает с URL бэкенда
PDF_BASE_URL=http://backend:8000


# ------------------------------------------------------------------------------
# 11. ИНИЦИАЛИЗАЦИЯ (только первый запуск)
# ------------------------------------------------------------------------------

# Суперадмин создаётся автоматически при первом migrate, если не существует
SUPERADMIN_EMAIL=admin@railtech.uz
SUPERADMIN_PASSWORD=CHANGE_ME_strong-admin-password

# Путь к JSON-файлу с сид-данными (справочники, тестовые категории)
SEED_DATA_PATH=core/data/seed_data.json
