        <mxCell id="b_wait1" value="⏳ BOTTLENECK: Ожидание РУЧНОЙ верификации админом. Нет автомата, нет SLA, нет напоминания." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
