        <mxCell id="b_catalog" value="Выбрать из каталога (browse PIM)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="1580" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_celery" value="Celery: process_excel_import max 5000 rows, timeout 600s bulk_create + recalculate_totals()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="-220" y="1680" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_import_lim" value="⏳ BOTTLENECK: &gt;5000 строк → падает rejects silently (sourcing/tasks.py:16)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="-220" y="1780" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_match" value="Smart Match Tier 1/2/3 exact → regex drawing → trigram (threshold 0.3) (sourcing/services.py:16)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="-220" y="1880" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_match_err" value="⚠ DEAD-END: Threshold 0.3 — FP matches; если ни один tier не попал — QuoteItem.product=NULL, менеджер матчит вручную" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1880" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_wait2" value="⏳ BOTTLENECK: Ожидание менеджера. Нет SLA / deadline. DRAFT → KYC_PENDING / SOURCING делается вручную." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="1680" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_srcng" value="Manager: transition_deal_stage DRAFT → SOURCING → CALCULATING (crm/services.py:340)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="1780" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_calc" value="QuoteCalculationService .recalculate_quote() frozen_base_price + logistics + customs + margin + VAT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="340" y="1880" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_pdf" value="generate_pdf(quote_id) WeasyPrint → MinIO (quote_pdf_path)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="340" y="1980" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_send" value="Manager: send_to_client() quote.status=SENT frozen_at=now() Deal → QUOTE_SENT + Notification" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="2080" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_notif" value="🔔 Notification (inline + WebSocket) «КП готово»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="2180" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_view" value="Открыть QuotesPage → PDF + QuoteItems" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="2280" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_dec2" value="Одобрить или отклонить?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="2380" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b_approve" value="approve_quote() quote.status=APPROVED Deal → CONTRACT_SIGNED (crm/services.py:226)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="-220" y="2480" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_reject" value="reject_quote(reason) quote.status=REJECTED Deal → CALCULATING + Notification manager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="2480" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_contract_de" value="⚠ DEAD-END: CONTRACT_SIGNED — это ТОЛЬКО МАРКЕР статуса. НЕТ файла договора, НЕТ e-sign, НЕТ SADT, НЕТ шаблонизатора." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="-220" y="2580" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_expiry_de" value="⚠ DEAD-END: Quote.valid_until хранится, но НЕ проверяется Celery-task. Устаревшая КП — висит." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="2480" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_loop" value="Менеджер пересчитывает → repeat send_to_client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="2580" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_close" value="Manager: transition_deal_stage CONTRACT_SIGNED → CLOSED_WON" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="2680" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_terminal" value="CLOSED_WON / CLOSED_LOST (ALLOWED_STAGE_TRANSITIONS:[]) Terminal — нельзя reopen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="2780" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_nopay" value="⚠ DEAD-END: НЕТ инвойса, НЕТ платежа, НЕТ акта, НЕТ счёта-фактуры. CLAUDE.md: «payments not implemented»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="2780" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note_0" value="КРИТИЧЕСКИЕ ТУПИКИ BUYER: • Хардкод CompanyType=CLIENT при онбординге — смена роли через CompanyRoleApplication (только Unfold). • Нет нотификации клиенту об L2_VERIFIED — непонятно, когда можно работать. • BUYER не видит меню «Сделки» — AppShell.tsx:105 прячет его от не-админа. • CONTRACT_SIGNED — фиктивный статус, нет файла / e-sign / документооборота. • Нет платёжного контура: SupplierSubscription есть, но биллинг отсутствует. • Quote.valid_until не триггерится Celery — КП «бессмертны»." style="text;html=1;strokeColor=#d6b656;fillColor=#ffffc0;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="2780" width="900" height="120" as="geometry" />
        </mxCell>
