          <mxGeometry x="60" y="1480" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b_excel" value="Загрузить Excel POST /sourcing/import-deal/{id} → base64 file" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="-220" y="1580" width="240" height="70" as="geometry" />
