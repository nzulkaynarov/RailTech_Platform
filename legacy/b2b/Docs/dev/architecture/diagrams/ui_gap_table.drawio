        <mxCell id="b0_t" value="BUYER нет меню Supplier Bids" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="1212" width="450" height="88" as="geometry" /></mxCell>
        <mxCell id="b0_p" value="AppShell.tsx:100-124" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="580" y="1212" width="420" height="88" as="geometry" /></mxCell>
        <mxCell id="b0_d" value="getBuyerNavigation не добавляет supplier-bids. BUYER создаёт RFQ, но не видит ставок и не может выбрать победителя. В App.tsx страница SupplierBidsPage доступна как роут, но пункт меню отсутствует." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1000" y="1212" width="1250" height="88" as="geometry" /></mxCell>
        <mxCell id="b1_s" value="CRIT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#8a3a35;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1302" width="90" height="88" as="geometry" /></mxCell>
        <mxCell id="b1_t" value="SELLER: кнопка «Leads» выкидывает на Dashboard" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="1302" width="450" height="88" as="geometry" /></mxCell>
        <mxCell id="b1_p" value="App.tsx:217-222, AppShell.tsx:189" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="580" y="1302" width="420" height="88" as="geometry" /></mxCell>
        <mxCell id="b1_d" value="&#x27;leads&#x27; включён в ADMIN_PAGES set. Role-guard (App.tsx:248-251, 299) редиректит SELLER и остальных на dashboard. Тихий редирект без тоста." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1000" y="1302" width="1250" height="88" as="geometry" /></mxCell>
        <mxCell id="b2_s" value="CRIT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#8a3a35;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1392" width="90" height="88" as="geometry" /></mxCell>
        <mxCell id="b2_t" value="MFG нет Sourcing → Excel Import" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="1392" width="450" height="88" as="geometry" /></mxCell>
        <mxCell id="b2_p" value="AppShell.tsx:138-143" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="580" y="1392" width="420" height="88" as="geometry" /></mxCell>
        <mxCell id="b2_d" value="getManufacturerNavigation включает только requests + smartMatch. SELLER (AppShell.tsx:179) имеет excel-import в том же блоке. MFG должен загружать свою номенклатуру — gap." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1000" y="1392" width="1250" height="88" as="geometry" /></mxCell>
        <mxCell id="b3_s" value="CRIT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#8a3a35;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1482" width="90" height="88" as="geometry" /></mxCell>
        <mxCell id="b3_t" value="MFG нет CRM → Clients, Leads, My Requests" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="1482" width="450" height="88" as="geometry" /></mxCell>
        <mxCell id="b3_p" value="AppShell.tsx:126-162" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="580" y="1482" width="420" height="88" as="geometry" /></mxCell>
        <mxCell id="b3_d" value="MFG не видит ни crm-clients, ни leads, ни my-requests. Даже если role=MANAGER в MFG-компании — условие `role===&#x27;MANAGER&#x27;` в getManufacturerNavigation ничего не добавляет (AppShell.tsx:158)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1000" y="1482" width="1250" height="88" as="geometry" /></mxCell>
        <mxCell id="b4_s" value="CRIT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#8a3a35;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1572" width="90" height="88" as="geometry" /></mxCell>
        <mxCell id="b4_t" value="MFG нет Billing → Payments" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="1572" width="450" height="88" as="geometry" /></mxCell>
        <mxCell id="b4_p" value="AppShell.tsx:148-156" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="580" y="1572" width="420" height="88" as="geometry" /></mxCell>
        <mxCell id="b4_d" value="У BUYER и SELLER в Billing есть пункт payments, у MFG (:148-156) — нет. При этом PaymentsPage доступна и ей нужны данные — gap." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1000" y="1572" width="1250" height="88" as="geometry" /></mxCell>
        <mxCell id="b5_s" value="CRIT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#8a3a35;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1662" width="90" height="88" as="geometry" /></mxCell>
        <mxCell id="b5_t" value="QuotesPage: кнопка «Создать КП» без onClick" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="1662" width="450" height="88" as="geometry" /></mxCell>
        <mxCell id="b5_p" value="pages/QuotesPage.tsx:116" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="580" y="1662" width="420" height="88" as="geometry" /></mxCell>
        <mxCell id="b5_d" value="actions={isBuyer ? undefined : [{ label: t(&#x27;pages.quotes.createQuote&#x27;) }]} — объект без onClick. PageShell рендерит Button с undefined handler. Клик не делает НИЧЕГО." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1000" y="1662" width="1250" height="88" as="geometry" /></mxCell>
        <mxCell id="b6_s" value="CRIT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#8a3a35;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1752" width="90" height="88" as="geometry" /></mxCell>
        <mxCell id="b6_t" value="MyRequestsPage: «Новая заявка» редиректит на dashboard" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="1752" width="450" height="88" as="geometry" /></mxCell>
        <mxCell id="b6_p" value="pages/MyRequestsPage.tsx:33" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="580" y="1752" width="420" height="88" as="geometry" /></mxCell>
        <mxCell id="b6_d" value="onClick: () =&gt; onNavigate?.(&#x27;catalog&#x27;) — но &#x27;catalog&#x27; НЕ входит в validTypes (App.tsx:285-296, там только &#x27;products&#x27;). handleNavigate(:304-306) уходит в default → navigateTo({ type: &#x27;dashboard&#x27; })." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1000" y="1752" width="1250" height="88" as="geometry" /></mxCell>
        <mxCell id="b7_s" value="CRIT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#8a3a35;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1842" width="90" height="88" as="geometry" /></mxCell>
        <mxCell id="b7_t" value="SourcingRequestsPage: «Создать запрос» — тот же баг" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="1842" width="450" height="88" as="geometry" /></mxCell>
        <mxCell id="b7_p" value="pages/SourcingRequestsPage.tsx:40" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="580" y="1842" width="420" height="88" as="geometry" /></mxCell>
        <mxCell id="b7_d" value="onClick: () =&gt; onNavigate?.(&#x27;catalog&#x27;) — дубликат проблемы. Пользователь нажимает, пропадает на dashboard." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1000" y="1842" width="1250" height="88" as="geometry" /></mxCell>
        <mxCell id="b8_s" value="HIGH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#aa7900;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1932" width="90" height="88" as="geometry" /></mxCell>
        <mxCell id="b8_t" value="RequestDetailPage: 10+ хардкод-строк на английском" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="1932" width="450" height="88" as="geometry" /></mxCell>
        <mxCell id="b8_p" value="pages/flow/RequestDetailPage.tsx:73,77,83,86,90,93,107,111,123,125" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="580" y="1932" width="420" height="88" as="geometry" /></mxCell>
        <mxCell id="b8_d" value="«Start Calculation», «Send Quote», «Approve», «Reject», «Deal Accepted», «No actions available», «Quote v», «Total Incl VAT», «Base Price», «Final Price» — без t(). Нарушает IRON RULE 5." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1000" y="1932" width="1250" height="88" as="geometry" /></mxCell>
        <mxCell id="b9_s" value="HIGH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#aa7900;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="2022" width="90" height="88" as="geometry" /></mxCell>
        <mxCell id="b9_t" value="RequestDetailPage: rejectQuote с хардкод-причиной" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="2022" width="450" height="88" as="geometry" /></mxCell>
        <mxCell id="b9_p" value="pages/flow/RequestDetailPage.tsx:85" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="580" y="2022" width="420" height="88" as="geometry" /></mxCell>
        <mxCell id="b9_d" value="rejectQuote(quote.id, &#x27;Rejected by user&#x27;) — нет диалога ввода причины. Все отклонения записываются с одним текстом на английском." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1000" y="2022" width="1250" height="88" as="geometry" /></mxCell>
        <mxCell id="b10_s" value="HIGH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#aa7900;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="2112" width="90" height="88" as="geometry" /></mxCell>
        <mxCell id="b10_t" value="BUYER Analytics — пустая страница" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="2112" width="450" height="88" as="geometry" /></mxCell>
        <mxCell id="b10_p" value="pages/AnalyticsPage.tsx:12-28" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="580" y="2112" width="420" height="88" as="geometry" /></mxCell>
        <mxCell id="b10_d" value="BuyerAnalytics возвращает PageShell со stats-строкой и закрывающим тегом — никаких графиков / таблиц / CTA. BUYER заходит, видит 2 числа и уходит." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1000" y="2112" width="1250" height="88" as="geometry" /></mxCell>
        <mxCell id="b11_s" value="HIGH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#aa7900;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="2202" width="90" height="88" as="geometry" /></mxCell>
        <mxCell id="b11_t" value="Dashboard: DropdownMenuItem «Export» / «Show All» без onClick" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="2202" width="450" height="88" as="geometry" /></mxCell>
        <mxCell id="b11_p" value="pages/Dashboard.tsx:64-65" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="580" y="2202" width="420" height="88" as="geometry" /></mxCell>
        <mxCell id="b11_d" value="&lt;DropdownMenuItem&gt;{t(&#x27;dashboardPage.export&#x27;)}&lt;/DropdownMenuItem&gt; — тег без handler. Кнопки кликабельны, но ничего не делают." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1000" y="2202" width="1250" height="88" as="geometry" /></mxCell>
        <mxCell id="b12_s" value="MED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d6b656;strokeColor=#a99133;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="2292" width="90" height="88" as="geometry" /></mxCell>
        <mxCell id="b12_t" value="QuoteBuilderGrid: window.confirm вместо AlertDialog" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="2292" width="450" height="88" as="geometry" /></mxCell>
        <mxCell id="b12_p" value="components/Admin/QuoteBuilderGrid.tsx:111" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="580" y="2292" width="420" height="88" as="geometry" /></mxCell>
        <mxCell id="b12_d" value="Использует нативное confirm() вместо shadcn AlertDialog. Нарушает design-system, ломает e2e-тесты, не интернационализируется по языку браузера." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1000" y="2292" width="1250" height="88" as="geometry" /></mxCell>
        <mxCell id="b13_s" value="MED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d6b656;strokeColor=#a99133;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="2382" width="90" height="88" as="geometry" /></mxCell>
        <mxCell id="b13_t" value="CompanyProfile: window.confirm для удаления" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="2382" width="450" height="88" as="geometry" /></mxCell>
        <mxCell id="b13_p" value="components/Cabinet/CompanyProfile.tsx:56" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="580" y="2382" width="420" height="88" as="geometry" /></mxCell>
        <mxCell id="b13_d" value="То же — браузерный confirm вместо AlertDialog." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1000" y="2382" width="1250" height="88" as="geometry" /></mxCell>
        <mxCell id="b14_s" value="MED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d6b656;strokeColor=#a99133;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="2472" width="90" height="88" as="geometry" /></mxCell>
        <mxCell id="b14_t" value="Dashboard: прямая манипуляция hash" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="2472" width="450" height="88" as="geometry" /></mxCell>
        <mxCell id="b14_p" value="pages/Dashboard.tsx:233" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="580" y="2472" width="420" height="88" as="geometry" /></mxCell>
        <mxCell id="b14_d" value="window.location.hash = &#x27;#profile&#x27; вместо navigateTo/onNavigate. Ломает state в useState, history записывается двойной." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1000" y="2472" width="1250" height="88" as="geometry" /></mxCell>
        <mxCell id="b15_s" value="MED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d6b656;strokeColor=#a99133;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="2562" width="90" height="88" as="geometry" /></mxCell>
        <mxCell id="b15_t" value="common.actions — OR fallback на English" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="2562" width="450" height="88" as="geometry" /></mxCell>
        <mxCell id="b15_p" value="pages/flow/RequestDetailPage.tsx:63" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="580" y="2562" width="420" height="88" as="geometry" /></mxCell>
        <mxCell id="b15_d" value="{t(&#x27;common.actions&#x27;) || &#x27;Actions&#x27;} — OR-фолбэк сигнализирует о missing i18n-ключе." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1000" y="2562" width="1250" height="88" as="geometry" /></mxCell>
        <mxCell id="b16_s" value="MED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d6b656;strokeColor=#a99133;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="2652" width="90" height="88" as="geometry" /></mxCell>
        <mxCell id="b16_t" value="OnboardingTour: onNavigate prop unused (_onNavigate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="2652" width="450" height="88" as="geometry" /></mxCell>
        <mxCell id="b16_p" value="components/Shared/OnboardingTour.tsx:26" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="580" y="2652" width="420" height="88" as="geometry" /></mxCell>
        <mxCell id="b16_d" value="Приставка `_` в деструктуризации = unused. Тур не умеет подсвечивать конкретную страницу, хотя App.tsx передаёт handleNavigate (:475)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;align=left;;fontSize=10;fontStyle=0;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1000" y="2652" width="1250" height="88" as="geometry" /></mxCell>
        <mxCell id="b17_s" value="LOW" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#3e5a80;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="2742" width="90" height="88" as="geometry" /></mxCell>
