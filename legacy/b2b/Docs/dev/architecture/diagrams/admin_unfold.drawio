        <mxCell id="u_user_de" value="⚠ DEAD-END:
make_staff меняет is_staff,
но НЕ назначает SystemRole.
Роль ADMIN / SALES_MANAGER
назначается через Django Group
или ручной UPDATE." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-220" y="480" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="u_kyc_de" value="⚠ DEAD-END:
verify_kyc не шлёт email
клиенту (TODO сервис).
Нет pghistory-триггера." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-220" y="580" width="240" height="70" as="geometry" /></mxCell>
