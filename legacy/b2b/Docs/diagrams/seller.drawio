Celery process_catalog_import" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1080" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="s_xls_de" value="⚠ DEAD-END:
