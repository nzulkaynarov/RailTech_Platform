        "success": "#166534",
        "success-foreground": "#ffffff",
        "warning": "#92400e",
        "warning-foreground": "#ffffff",
        "info": "#1d4ed8",
        "info-foreground": "#ffffff",
        "border": "#e2e8f0",
        "input": "#cbd5e1",
        "ring": "#1f2e4a",
        "radius": "0.5rem"
      },
      "dark": {
        "background": "#17212b",
        "foreground": "#f5f5f5",
        "card": "#232e3c",
        "card-foreground": "#f5f5f5",
        "popover": "#232e3c",
        "popover-foreground": "#f5f5f5",
        "primary": "#82aaff",
