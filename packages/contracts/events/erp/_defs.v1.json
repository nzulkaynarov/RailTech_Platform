{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://railtech.uz/contracts/events/erp/_defs.v1.json",
  "title": "Общие определения событий ERP v1",
  "description": "Не тип события: определения, на которые ссылаются схемы events/erp/*.v1.json. Перенесены из events.schema.json без изменений (кроме ClientActor — бывшее условие actor.type=client для delivery.line_*).",
  "$defs": {
    "Amount": {
      "type": "string",
      "pattern": "^-?\\d+\\.\\d{2}$"
    },
    "Currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "DealStage": {
      "type": "string",
      "enum": [
        "request",
        "quoting",
        "quote_sent",
        "accepted",
        "contract",
        "invoiced",
        "paid",
        "fulfilment",
        "closing",
        "won",
        "lost"
      ]
    },
    "DealRef": {
      "type": "object",
      "required": [
        "erp_deal_id",
        "number",
        "title",
        "stage",
        "amount",
        "currency"
      ],
      "properties": {
        "erp_deal_id": {
          "type": "integer"
        },
        "number": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/DealStage"
        },
        "amount": {
          "description": "Сумма последней версии КП, отправленной клиенту; null — КП клиенту ещё не отправлялось (черновики и КП на согласовании не учитываются)",
          "oneOf": [
            {
              "$ref": "#/$defs/Amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        }
      },
      "additionalProperties": false
    },
    "Actor": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "system",
            "staff",
            "client"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ClientActor": {
      "type": "object",
      "description": "Действие клиента в Cabinet (Actor с type=client)",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "client"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RequestCreated": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "crm",
            "cabinet",
            "erp"
          ]
        },
        "erp_request_id": {
          "type": "integer"
        },
        "summary": {
          "type": "string"
        },
        "company_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Название компании клиента (отправитель письма EDS по заявке). Необязательное, с 2026-10-26 (C1-G-7); нет — EDS показывает клиента по crm_client_id"
        },
        "company_inn": {
          "type": "string",
          "pattern": "^\\d{9,14}$",
          "description": "ИНН компании клиента; публикуется, только если похож на ИНН (9–14 цифр). Необязательное (C1-G-7)"
        },
        "contact_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "Контактное лицо клиента по заявке (офлайн-контакт сделки, представитель клиента или основной контакт передачи из CRM). Необязательное (C1-G-7)"
        },
        "manager_crm_user_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Менеджер заявки — сотрудник CRM (crm_user_id): ответственный передачи из CRM, иначе ответственный сделки ERP с сопоставлением CRM. Нет — менеджер не назначен. Необязательное (C1-G-7)"
        }
      },
      "additionalProperties": false
    },
    "DealStageChanged": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/DealStage"
        },
        "to": {
          "$ref": "#/$defs/DealStage"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "QuoteSent": {
      "type": "object",
      "required": [
        "erp_quote_id",
        "version",
        "public_url"
      ],
      "properties": {
        "erp_quote_id": {
          "type": "integer"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "public_url": {
          "type": "string",
          "format": "uri"
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "total": {
          "$ref": "#/$defs/Amount"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        }
      },
      "additionalProperties": false
    },
    "QuoteOutcome": {
      "type": "object",
      "required": [
        "erp_quote_id",
        "version"
      ],
      "properties": {
        "erp_quote_id": {
          "type": "integer"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string"
        },
        "erp_contact_id": {
          "type": "integer",
          "description": "Контакт клиента, который принял или отклонил КП (Q-FIX22-6); нет — действие не из Cabinet"
        },
        "crm_contact_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Тот же контакт в CRM, если сопоставлен"
        }
      },
      "additionalProperties": false
    },
    "QuoteAcceptanceCodeRequested": {
      "type": "object",
      "description": "Клиент запросил код акцепта в Cabinet, контакт в Telegram: код доставляет бот CRM (Q-FIX22-1). ERP шлёт событие только контакту с crm_contact_id и telegram; иначе код уходит письмом ERP",
      "required": [
        "erp_quote_id",
        "version",
        "erp_contact_id",
        "crm_contact_id",
        "code",
        "expires_at"
      ],
      "properties": {
        "erp_quote_id": {
          "type": "integer"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "erp_contact_id": {
          "type": "integer"
        },
        "crm_contact_id": {
          "type": "integer"
        },
        "code": {
          "type": "string",
          "pattern": "^[0-9]{4,12}$",
          "description": "Одноразовый код — секрет: не хранить и не логировать в CRM"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "ContractSigned": {
      "type": "object",
      "required": [
        "erp_contract_id",
        "by"
      ],
      "properties": {
        "erp_contract_id": {
          "type": "integer"
        },
        "number": {
          "type": "string"
        },
        "by": {
          "type": "string",
          "enum": [
            "client",
            "company",
            "both"
          ]
        }
      },
      "additionalProperties": false
    },
    "InvoiceEvent": {
      "type": "object",
      "required": [
        "erp_invoice_id",
        "number",
        "amount",
        "currency",
        "due_date"
      ],
      "properties": {
        "erp_invoice_id": {
          "type": "integer"
        },
        "number": {
          "type": "string"
        },
        "amount": {
          "$ref": "#/$defs/Amount"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "due_date": {
          "type": "string",
          "format": "date"
        },
        "link": {
          "type": "string",
          "format": "uri",
          "description": "Ссылка на счёт в Cabinet"
        },
        "erp_document_id": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "DeliveryEvent": {
      "type": "object",
      "required": [
        "line_summary",
        "status"
      ],
      "properties": {
        "line_summary": {
          "type": "string",
          "description": "Краткое описание строк, к которым относится событие"
        },
        "line_nos": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "assembling",
            "in_transit",
            "ready_to_ship",
            "shipped",
            "delivered"
          ]
        },
        "eta": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "previous_eta": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "tracking": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "DeliveryLineDecision": {
      "type": "object",
      "description": "Решение клиента по строке поставки в Cabinet (FIX-22): принял или оспорил с замечанием",
      "required": [
        "line_no",
        "title",
        "status",
        "decided_at"
      ],
      "properties": {
        "line_no": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "disputed"
          ]
        },
        "remark": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000,
          "description": "Замечание клиента; обязательно при disputed"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "status": {
            "const": "disputed"
          }
        }
      },
      "then": {
        "required": [
          "remark"
        ],
        "properties": {
          "remark": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ActEvent": {
      "type": "object",
      "required": [
        "erp_act_id",
        "number"
      ],
      "properties": {
        "erp_act_id": {
          "type": "integer"
        },
        "number": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "erp_document_id": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "DealOutcome": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "$ref": "#/$defs/Amount"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "lost_reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "DocumentCreated": {
      "type": "object",
      "required": [
        "erp_document_id",
        "kind",
        "number"
      ],
      "properties": {
        "erp_document_id": {
          "type": "integer"
        },
        "kind": {
          "type": "string",
          "enum": [
            "quote",
            "contract",
            "invoice",
            "act",
            "waybill",
            "receipt",
            "other"
          ]
        },
        "number": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "InviteSent": {
      "type": "object",
      "required": [
        "channels"
      ],
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "telegram",
              "email"
            ]
          }
        },
        "erp_contact_id": {
          "type": "integer"
        },
        "crm_contact_id": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "InviteRequested": {
      "type": "object",
      "description": "Приглашение контакта в Cabinet через бот CRM (D1-9). Рабочей ссылки и токенов нет: контакт входит в Mini App по своему Telegram-аккаунту (initData), поэтому событие не секретно.",
      "required": [
        "channel",
        "erp_contact_id",
        "crm_contact_id"
      ],
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "telegram"
          ]
        },
        "erp_contact_id": {
          "type": "integer"
        },
        "crm_contact_id": {
          "type": "integer"
        },
        "language": {
          "type": "string",
          "enum": [
            "ru",
            "uz",
            "en"
          ],
          "description": "Язык контакта в ERP; бот CRM берёт язык лида, если он известен"
        }
      },
      "additionalProperties": false
    },
    "CalcZone": {
      "type": "string",
      "enum": [
        "goods",
        "services"
      ],
      "description": "Зона визы расчёта: goods — товары и склад (снабженец), services — услуги (гл. инженер); ADR-0012 п. 6"
    },
    "QuoteVisaAuthor": {
      "type": "object",
      "required": [
        "crm_user_id",
        "full_name"
      ],
      "properties": {
        "crm_user_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "null — сотрудник ERP без связи с CRM"
        },
        "full_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "additionalProperties": false
    },
    "QuoteVisa": {
      "type": "object",
      "description": "Виза строки расчёта по зоне: кто и когда",
      "required": [
        "zone",
        "by",
        "at"
      ],
      "properties": {
        "zone": {
          "$ref": "#/$defs/CalcZone"
        },
        "by": {
          "$ref": "#/$defs/QuoteVisaAuthor"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "QuoteReadyForApproval": {
      "type": "object",
      "description": "Снимок КП для маршрута одобрения в EDS (EDS-03): суммы, маржа, визы, порог маржи резолюции",
      "required": [
        "erp_quote_id",
        "number",
        "version",
        "total",
        "currency",
        "margin_pct",
        "min_margin_pct",
        "required_zones",
        "visas",
        "ready_at"
      ],
      "properties": {
        "erp_quote_id": {
          "type": "integer"
        },
        "number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "КП-ГГГГ/NNN"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "client_name": {
          "type": "string",
          "maxLength": 255
        },
        "total": {
          "$ref": "#/$defs/Amount",
          "description": "Сумма КП с НДС"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "cost": {
          "$ref": "#/$defs/Amount",
          "description": "Себестоимость (видит только директор)"
        },
        "margin_amount": {
          "$ref": "#/$defs/Amount"
        },
        "margin_pct": {
          "type": "string",
          "pattern": "^-?\\d{1,3}(\\.\\d{1,2})?$",
          "description": "Маржа КП, % строкой; может быть отрицательной"
        },
        "min_margin_pct": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(100(\\.0{1,2})?|\\d{1,2}(\\.\\d{1,2})?)$",
          "description": "Порог «маржа не ниже, %» из резолюции (letter.resolved) — снимок для показа; чек-лист EDS сверяет маржу с порогом своей резолюции (владелец поля — EDS). null — ограничения нет"
        },
        "required_zones": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/CalcZone"
          },
          "description": "Чьи визы нужны расчёту (по строкам КП и исполнителям резолюции)"
        },
        "visas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuoteVisa"
          },
          "description": "Собранные визы: снабженец — goods, гл. инженер — services"
        },
        "due": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Срок расчёта из резолюции"
        },
        "ready_at": {
          "type": "string",
          "format": "date-time",
          "description": "Когда расчёт объявлен готовым"
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Срок действия КП"
        },
        "eds_letter_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "description": "Входящее письмо EDS, по резолюции которого считали (из letter.resolved)"
        }
      },
      "additionalProperties": false
    }
  }
}
