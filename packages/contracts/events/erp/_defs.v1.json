{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://railtech.uz/contracts/events/erp/_defs.v1.json",
  "title": "Общие определения событий ERP v1",
  "description": "Не тип события: определения, на которые ссылаются схемы events/erp/*.v1.json. Перенесены из events.schema.json без изменений (кроме ClientActor — бывшее условие actor.type=client для delivery.line_*).",
  "$defs": {
    "Amount": {
      "type": "string",
      "pattern": "^-?\\d+\\.\\d{2}$"
    },
    "Currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "DealStage": {
      "type": "string",
      "enum": [
        "request",
        "quoting",
        "quote_sent",
        "accepted",
        "contract",
        "invoiced",
        "paid",
        "fulfilment",
        "closing",
        "won",
        "lost"
      ]
    },
    "DealRef": {
      "type": "object",
      "required": [
        "erp_deal_id",
        "number",
        "title",
        "stage",
        "amount",
        "currency"
      ],
      "properties": {
        "erp_deal_id": {
          "type": "integer"
        },
        "number": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/DealStage"
        },
        "amount": {
          "description": "Сумма последней версии КП, отправленной клиенту; null — КП клиенту ещё не отправлялось (черновики и КП на согласовании не учитываются)",
          "oneOf": [
            {
              "$ref": "#/$defs/Amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        }
      },
      "additionalProperties": false
    },
    "Actor": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "system",
            "staff",
            "client"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ClientActor": {
      "type": "object",
      "description": "Действие клиента в Cabinet (Actor с type=client)",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "client"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RequestCreated": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "crm",
            "cabinet",
            "erp"
          ]
        },
        "erp_request_id": {
          "type": "integer"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "DealStageChanged": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/DealStage"
        },
        "to": {
          "$ref": "#/$defs/DealStage"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "QuoteSent": {
      "type": "object",
      "required": [
        "erp_quote_id",
        "version",
        "public_url"
      ],
      "properties": {
        "erp_quote_id": {
          "type": "integer"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "public_url": {
          "type": "string",
          "format": "uri"
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "total": {
          "$ref": "#/$defs/Amount"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        }
      },
      "additionalProperties": false
    },
    "QuoteOutcome": {
      "type": "object",
      "required": [
        "erp_quote_id",
        "version"
      ],
      "properties": {
        "erp_quote_id": {
          "type": "integer"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string"
        },
        "erp_contact_id": {
          "type": "integer",
          "description": "Контакт клиента, который принял или отклонил КП (Q-FIX22-6); нет — действие не из Cabinet"
        },
        "crm_contact_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Тот же контакт в CRM, если сопоставлен"
        }
      },
      "additionalProperties": false
    },
    "QuoteAcceptanceCodeRequested": {
      "type": "object",
      "description": "Клиент запросил код акцепта в Cabinet, контакт в Telegram: код доставляет бот CRM (Q-FIX22-1). ERP шлёт событие только контакту с crm_contact_id и telegram; иначе код уходит письмом ERP",
      "required": [
        "erp_quote_id",
        "version",
        "erp_contact_id",
        "crm_contact_id",
        "code",
        "expires_at"
      ],
      "properties": {
        "erp_quote_id": {
          "type": "integer"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "erp_contact_id": {
          "type": "integer"
        },
        "crm_contact_id": {
          "type": "integer"
        },
        "code": {
          "type": "string",
          "pattern": "^[0-9]{4,12}$",
          "description": "Одноразовый код — секрет: не хранить и не логировать в CRM"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "ContractSigned": {
      "type": "object",
      "required": [
        "erp_contract_id",
        "by"
      ],
      "properties": {
        "erp_contract_id": {
          "type": "integer"
        },
        "number": {
          "type": "string"
        },
        "by": {
          "type": "string",
          "enum": [
            "client",
            "company",
            "both"
          ]
        }
      },
      "additionalProperties": false
    },
    "InvoiceEvent": {
      "type": "object",
      "required": [
        "erp_invoice_id",
        "number",
        "amount",
        "currency",
        "due_date"
      ],
      "properties": {
        "erp_invoice_id": {
          "type": "integer"
        },
        "number": {
          "type": "string"
        },
        "amount": {
          "$ref": "#/$defs/Amount"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "due_date": {
          "type": "string",
          "format": "date"
        },
        "link": {
          "type": "string",
          "format": "uri",
          "description": "Ссылка на счёт в Cabinet"
        },
        "erp_document_id": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "DeliveryEvent": {
      "type": "object",
      "required": [
        "line_summary",
        "status"
      ],
      "properties": {
        "line_summary": {
          "type": "string",
          "description": "Краткое описание строк, к которым относится событие"
        },
        "line_nos": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "assembling",
            "in_transit",
            "ready_to_ship",
            "shipped",
            "delivered"
          ]
        },
        "eta": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "previous_eta": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "tracking": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "DeliveryLineDecision": {
      "type": "object",
      "description": "Решение клиента по строке поставки в Cabinet (FIX-22): принял или оспорил с замечанием",
      "required": [
        "line_no",
        "title",
        "status",
        "decided_at"
      ],
      "properties": {
        "line_no": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "disputed"
          ]
        },
        "remark": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000,
          "description": "Замечание клиента; обязательно при disputed"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "status": {
            "const": "disputed"
          }
        }
      },
      "then": {
        "required": [
          "remark"
        ],
        "properties": {
          "remark": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ActEvent": {
      "type": "object",
      "required": [
        "erp_act_id",
        "number"
      ],
      "properties": {
        "erp_act_id": {
          "type": "integer"
        },
        "number": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "erp_document_id": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "DealOutcome": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "$ref": "#/$defs/Amount"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "lost_reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "DocumentCreated": {
      "type": "object",
      "required": [
        "erp_document_id",
        "kind",
        "number"
      ],
      "properties": {
        "erp_document_id": {
          "type": "integer"
        },
        "kind": {
          "type": "string",
          "enum": [
            "quote",
            "contract",
            "invoice",
            "act",
            "waybill",
            "receipt",
            "other"
          ]
        },
        "number": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "InviteSent": {
      "type": "object",
      "required": [
        "channels"
      ],
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "telegram",
              "email"
            ]
          }
        },
        "erp_contact_id": {
          "type": "integer"
        },
        "crm_contact_id": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  }
}
