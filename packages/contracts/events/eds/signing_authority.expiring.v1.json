{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://railtech.uz/contracts/events/eds/signing_authority.expiring.v1.json",
  "title": "Полномочие подписи скоро истекает",
  "description": "Тип uz.railtech.eds.signing_authority.expiring.v1, источник rt://eds. Поле data конверта (envelope.v1.json). Напоминание (SIGN-2, ADR-0024 п. 1): до окончания срока полномочия подписи (доверенность, приказ со сроком) осталось не больше 14 дней — держателям права `signing.manage` (раздел `eds.signing.manage` каталога ролей). Текст (RU) готовит EDS, доставляет CRM тем же путём, что `notice.requested`: строка колокольчика (`staff_notifications`) и сообщение в Telegram, где он привязан. Одно напоминание на полномочие и дату окончания (перенос срока разрешает новое); повтор доставки того же события — один эффект (inbox CRM). Подписчики v1: crm (доставка).",
  "type": "object",
  "required": [
    "notice_key",
    "recipients",
    "title",
    "authority",
    "actor"
  ],
  "properties": {
    "notice_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
      "description": "Ключ отправителя: EDS публикует напоминание с этим ключом один раз (полномочие и дата окончания)"
    },
    "recipients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "integer"
      },
      "description": "crm_user_id держателей права `signing.manage`"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Заголовок уведомления (RU): чья доверенность и когда заканчивается"
    },
    "subtitle": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200,
      "description": "Вторая строка: что сделать"
    },
    "authority": {
      "type": "object",
      "required": [
        "eds_authority_id",
        "holder",
        "basis",
        "valid_to",
        "days_left"
      ],
      "properties": {
        "eds_authority_id": {
          "$ref": "_defs.v1.json#/$defs/Uuid"
        },
        "holder": {
          "type": "object",
          "required": [
            "crm_user_id",
            "full_name"
          ],
          "properties": {
            "crm_user_id": {
              "type": "integer"
            },
            "full_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          },
          "additionalProperties": false
        },
        "basis": {
          "type": "string",
          "enum": [
            "charter",
            "order",
            "power_of_attorney"
          ]
        },
        "basis_number": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "valid_to": {
          "type": "string",
          "format": "date"
        },
        "days_left": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "actor": {
      "$ref": "_defs.v1.json#/$defs/Actor"
    }
  },
  "additionalProperties": false
}
