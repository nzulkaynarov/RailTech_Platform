{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://railtech.uz/contracts/client-request-statuses.schema.json",
  "title": "Статусы заявки для клиента (client-request-statuses.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "statuses", "by_external_stage"],
  "properties": {
    "version": { "const": 1 },
    "statuses": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z_]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ru", "uz", "en"],
            "properties": {
              "ru": { "type": "string", "minLength": 1, "maxLength": 40 },
              "uz": { "type": "string", "minLength": 1, "maxLength": 40 },
              "en": { "type": "string", "minLength": 1, "maxLength": 40 }
            }
          }
        }
      }
    },
    "by_external_stage": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z_]*$" },
      "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z_]*$" }
    }
  }
}
