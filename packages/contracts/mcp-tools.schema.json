{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://railtech.uz/contracts/mcp-tools.schema.json",
  "title": "Описание MCP-сервера erp-mcp",
  "type": "object",
  "required": ["server", "version", "transport", "path", "context", "tools"],
  "properties": {
    "$schema": { "type": "string" },
    "server": { "type": "string", "const": "erp-mcp" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "transport": { "type": "string", "enum": ["streamable-http", "sse"] },
    "path": { "type": "string", "pattern": "^/" },
    "context": {
      "type": "object",
      "required": ["header", "description", "claims"],
      "properties": {
        "header": { "type": "string", "const": "X-Agent-Context" },
        "description": { "type": "string" },
        "claims": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "modes", "description", "input_schema", "output"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["prospect", "customer"] }
          },
          "description": { "type": "string", "minLength": 10 },
          "input_schema": {
            "type": "object",
            "description": "JSON Schema входа инструмента. Поля с идентификатором клиента/компании запрещены — они берутся из контекста.",
            "required": ["type", "properties"],
            "properties": {
              "type": { "const": "object" },
              "properties": {
                "type": "object",
                "propertyNames": {
                  "not": { "enum": ["crm_client_id", "erp_company_id", "client_id", "company_id"] }
                }
              }
            }
          },
          "output": { "type": "string", "minLength": 5 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
