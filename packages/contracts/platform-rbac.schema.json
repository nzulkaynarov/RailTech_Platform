{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://railtech.uz/contracts/platform-rbac.schema.json",
  "title": "Каталог возможностей Платформы, версия 2 (platform-rbac.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "system_roles",
    "templates",
    "crm_base_role",
    "resources",
    "menu",
    "restricted_fields",
    "queue"
  ],
  "$defs": {
    "level": {
      "enum": [
        "full",
        "read"
      ],
      "description": "Уровень хранимого доступа; скрытый раздел в access не записывается"
    },
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ru",
        "uz",
        "en"
      ],
      "properties": {
        "ru": {
          "type": "string",
          "minLength": 1
        },
        "uz": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "erpPermission": {
      "enum": [
        "deal.manage",
        "deal.assign",
        "quote.build",
        "quote.edit_pricing",
        "quote.view_cost_margin",
        "quote.send",
        "quote.review",
        "quote.visa_goods",
        "quote.visa_services",
        "contract.manage",
        "contract.sign",
        "catalog.manage",
        "catalog.publish",
        "supply.manage",
        "fulfillment.manage",
        "fulfillment.act",
        "finance.invoice",
        "finance.payment",
        "finance.rates",
        "settings.edit",
        "settings.charge_templates",
        "team.manage",
        "data.export"
      ]
    },
    "crmPermission": {
      "enum": [
        "leads:read",
        "leads:take",
        "leads:work",
        "leads:reply",
        "leads:note",
        "leads:assist",
        "leads:create",
        "stream:read",
        "dashboard:read",
        "clients:read",
        "clients:write",
        "deals:read",
        "deals:write",
        "documents:read",
        "documents:write",
        "users:read",
        "users:write",
        "settings:read",
        "settings:write",
        "kb:read",
        "kb:write",
        "audit:read",
        "backups:read",
        "backups:write",
        "spend:read",
        "models:read",
        "models:test",
        "models:write",
        "integrations:read",
        "integrations:write",
        "system:read",
        "sandbox:use",
        "reply_templates:read",
        "reply_templates:write",
        "export:read",
        "external_services:read",
        "external_services:write",
        "tickets:read",
        "tickets:write",
        "chats:read",
        "chats:reply",
        "chats:note",
        "chats:assist",
        "chats:invoiced"
      ]
    },
    "edsPermission": {
      "enum": [
        "letters.read",
        "letters.register",
        "letters.resolve",
        "memos.create",
        "memos.approve",
        "approvals.decide",
        "registry.read",
        "registry.export",
        "payments.confirm",
        "bus.manage"
      ],
      "description": "Код права EDS v1 (docs/runbooks/wave12-eds-c1.md §2.2; EdsPermission в openapi/eds.yaml)"
    },
    "queueKind": {
      "enum": [
        "answer_lead",
        "take_lead",
        "create_request",
        "service_request",
        "resolve_letter",
        "approve_quote",
        "approve_memo",
        "rework_document",
        "problem_project",
        "calc_task",
        "supplier_overdue",
        "confirm_payment",
        "issue_invoice",
        "issue_contract",
        "attach_scan",
        "pay_memo",
        "overdue_invoice",
        "ticket",
        "integration_issue"
      ]
    },
    "resourceKey": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z_]+)*$"
    },
    "fieldKey": {
      "type": "string",
      "pattern": "^[a-z_]+$"
    },
    "legacyRoleCode": {
      "enum": [
        "MANAGER",
        "DIRECTOR",
        "SUPPLY",
        "ENGINEER",
        "ACCOUNTANT",
        "ADMIN"
      ]
    },
    "access": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/resourceKey"
      },
      "additionalProperties": {
        "$ref": "#/$defs/level"
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "access",
        "restricted_fields"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/i18n"
        },
        "access": {
          "$ref": "#/$defs/access"
        },
        "restricted_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fieldKey"
          }
        }
      }
    },
    "backendList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/crmPermission"
      }
    },
    "erpList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/erpPermission"
      }
    },
    "edsList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/edsPermission"
      }
    },
    "resourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "level"
      ],
      "properties": {
        "resource": {
          "$ref": "#/$defs/resourceKey"
        },
        "level": {
          "$ref": "#/$defs/level"
        }
      }
    }
  },
  "properties": {
    "version": {
      "const": 2
    },
    "system_roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ADMIN",
        "DIRECTOR"
      ],
      "properties": {
        "ADMIN": {
          "$ref": "#/$defs/role"
        },
        "DIRECTOR": {
          "$ref": "#/$defs/role"
        }
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "MANAGER",
        "SUPPLY",
        "ENGINEER",
        "ACCOUNTANT"
      ],
      "properties": {
        "MANAGER": {
          "$ref": "#/$defs/role"
        },
        "SUPPLY": {
          "$ref": "#/$defs/role"
        },
        "ENGINEER": {
          "$ref": "#/$defs/role"
        },
        "ACCOUNTANT": {
          "$ref": "#/$defs/role"
        }
      }
    },
    "crm_base_role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_code",
        "by_access"
      ],
      "properties": {
        "by_code": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "MANAGER",
            "DIRECTOR",
            "SUPPLY",
            "ENGINEER",
            "ACCOUNTANT",
            "ADMIN"
          ],
          "properties": {
            "MANAGER": {
              "enum": [
                "admin",
                "manager",
                "viewer"
              ]
            },
            "DIRECTOR": {
              "enum": [
                "admin",
                "manager",
                "viewer"
              ]
            },
            "SUPPLY": {
              "enum": [
                "admin",
                "manager",
                "viewer"
              ]
            },
            "ENGINEER": {
              "enum": [
                "admin",
                "manager",
                "viewer"
              ]
            },
            "ACCOUNTANT": {
              "enum": [
                "admin",
                "manager",
                "viewer"
              ]
            },
            "ADMIN": {
              "enum": [
                "admin",
                "manager",
                "viewer"
              ]
            }
          }
        },
        "by_access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "admin",
            "manager"
          ],
          "properties": {
            "admin": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/resourceRef"
              }
            },
            "manager": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/resourceRef"
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "module",
          "label"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/resourceKey"
          },
          "module": {
            "enum": [
              "dashboard",
              "crm",
              "eds",
              "erp",
              "chats",
              "admin"
            ]
          },
          "levels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/level"
            },
            "description": "Допустимые уровни раздела; по умолчанию [read, full]"
          },
          "label": {
            "$ref": "#/$defs/i18n"
          },
          "backend": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "crm": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "read": {
                    "$ref": "#/$defs/backendList"
                  },
                  "full": {
                    "$ref": "#/$defs/backendList"
                  }
                }
              },
              "erp": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "read": {
                    "$ref": "#/$defs/erpList"
                  },
                  "full": {
                    "$ref": "#/$defs/erpList"
                  }
                }
              },
              "eds": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "read": {
                    "$ref": "#/$defs/edsList"
                  },
                  "full": {
                    "$ref": "#/$defs/edsList"
                  }
                }
              }
            }
          }
        }
      }
    },
    "restricted_fields": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/fieldKey"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "backend"
        ],
        "properties": {
          "description": {
            "$ref": "#/$defs/i18n"
          },
          "backend": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "erp"
            ],
            "properties": {
              "erp": {
                "$ref": "#/$defs/erpList"
              }
            }
          }
        }
      }
    },
    "menu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dashboard",
        "crm",
        "eds",
        "erp",
        "chats",
        "admin"
      ],
      "properties": {
        "dashboard": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z_]+$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z]+(\\.[a-z_]+)*$"
            }
          }
        },
        "crm": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z_]+$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z]+(\\.[a-z_]+)*$"
            }
          }
        },
        "eds": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z_]+$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z]+(\\.[a-z_]+)*$"
            }
          }
        },
        "erp": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z_]+$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z]+(\\.[a-z_]+)*$"
            }
          }
        },
        "chats": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z_]+$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z]+(\\.[a-z_]+)*$"
            }
          }
        },
        "admin": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z_]+$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z]+(\\.[a-z_]+)*$"
            }
          }
        }
      }
    },
    "queue": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/queueKind"
      },
      "additionalProperties": {
        "$ref": "#/$defs/resourceRef"
      }
    }
  }
}
