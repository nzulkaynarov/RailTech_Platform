{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://railtech.uz/contracts/platform-rbac.schema.json",
  "title": "Ролевая матрица Платформы (platform-rbac.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "roles", "resources", "restricted_fields"],
  "$defs": {
    "role": { "enum": ["MANAGER", "DIRECTOR", "SUPPLY", "ENGINEER", "ACCOUNTANT", "ADMIN"] },
    "level": { "enum": ["full", "read", "hidden"] },
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ru", "uz", "en"],
      "properties": {
        "ru": { "type": "string", "minLength": 1 },
        "uz": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "erpRoleCode": { "enum": ["CALCULATION", "CATALOG_SUPPLY", "FULFILLMENT", "FINANCE", "HEAD", "VIEWER"] },
    "erpPermission": {
      "enum": [
        "deal.manage", "deal.assign",
        "quote.build", "quote.edit_pricing", "quote.view_cost_margin", "quote.send", "quote.review", "quote.approve_final",
        "contract.manage", "contract.sign",
        "catalog.manage", "catalog.publish",
        "supply.manage",
        "fulfillment.manage", "fulfillment.act",
        "finance.invoice", "finance.payment", "finance.rates",
        "settings.edit", "settings.charge_templates",
        "team.manage",
        "data.export"
      ]
    },
    "queueKind": {
      "enum": [
        "answer_lead", "take_lead", "create_request", "service_request",
        "resolve_letter", "approve_quote", "approve_memo", "problem_project",
        "calc_task", "supplier_overdue",
        "confirm_payment", "issue_invoice", "issue_contract", "attach_scan", "pay_memo", "overdue_invoice",
        "ticket", "integration_issue"
      ]
    },
    "roleDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "crm_base_role", "erp_role_codes", "erp_extra_permissions", "queue"],
      "properties": {
        "name": { "$ref": "#/$defs/i18n" },
        "crm_base_role": { "enum": ["admin", "manager", "viewer"] },
        "erp_role_codes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/erpRoleCode" } },
        "erp_extra_permissions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/erpPermission" } },
        "queue": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/queueKind" } }
      }
    },
    "accessRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["MANAGER", "DIRECTOR", "SUPPLY", "ENGINEER", "ACCOUNTANT", "ADMIN"],
      "properties": {
        "MANAGER": { "$ref": "#/$defs/level" },
        "DIRECTOR": { "$ref": "#/$defs/level" },
        "SUPPLY": { "$ref": "#/$defs/level" },
        "ENGINEER": { "$ref": "#/$defs/level" },
        "ACCOUNTANT": { "$ref": "#/$defs/level" },
        "ADMIN": { "$ref": "#/$defs/level" }
      }
    }
  },
  "properties": {
    "version": { "const": 1 },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["MANAGER", "DIRECTOR", "SUPPLY", "ENGINEER", "ACCOUNTANT", "ADMIN"],
      "properties": {
        "MANAGER": { "$ref": "#/$defs/roleDef" },
        "DIRECTOR": { "$ref": "#/$defs/roleDef" },
        "SUPPLY": { "$ref": "#/$defs/roleDef" },
        "ENGINEER": { "$ref": "#/$defs/roleDef" },
        "ACCOUNTANT": { "$ref": "#/$defs/roleDef" },
        "ADMIN": { "$ref": "#/$defs/roleDef" }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "module", "label", "access"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z]+(\\.[a-z_]+)*$" },
          "module": { "enum": ["dashboard", "crm", "eds", "erp", "chats", "admin"] },
          "label": { "$ref": "#/$defs/i18n" },
          "access": { "$ref": "#/$defs/accessRow" }
        }
      }
    },
    "restricted_fields": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "visible_to"],
        "properties": {
          "description": { "$ref": "#/$defs/i18n" },
          "visible_to": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/role" } }
        }
      }
    }
  }
}
