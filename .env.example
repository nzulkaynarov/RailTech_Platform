# RailTech Platform — переменные окружения стенда ансамбля (infra/compose). Скопируйте в .env:
#   make env        — создаёт .env из этого файла и заменяет CHANGE_ME случайными значениями.
# Секреты только здесь, в репозиторий не коммитятся (ORCHESTRATOR §3.6). Читают их только compose
# и конфиги приложений. Переменные CRM со своими именами — см. apps/crm/.env.example (здесь они
# переименованы с префиксом CRM_, compose отдаёт их приложению под прежними именами).

# --- Приложение ---------------------------------------------------------------------------
# dev | prod | test
APP_ENV=dev
LOG_LEVEL=INFO
# json (для docker logs / Loki) | console (читаемый, локально)
LOG_FORMAT=json
READY_CHECK_TIMEOUT_S=2

# --- PostgreSQL 17 (базы crm, erp, litellm, langfuse на одной инстанции) --------------------
# Один суперпользователь инстанции на dev; на prod — отдельные роли на базу (M5-INF-01).
POSTGRES_USER=rt
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis: два экземпляра с разными паролями (S0-2) ---------------------------------------------------------------
# redis-broker: БД 1 — Celery ERP (брокер и результаты), 2 — Channels ERP; appendonly, noeviction.
REDIS_BROKER_PASSWORD=CHANGE_ME
# redis-cache: БД 0 — кэш, троттлинг и одноразовые jti ERP, 3 — сессии BFF Платформы, 4 — Langfuse; volatile-lru.
REDIS_CACHE_PASSWORD=CHANGE_ME
# Необязательно: предел памяти (maxmemory) экземпляров; по умолчанию 128mb у брокера и 96mb у кэша.
# REDIS_BROKER_MAXMEMORY=128mb
# REDIS_CACHE_MAXMEMORY=96mb

# --- S3: RustFS (бакеты CRM, Langfuse и ERP — erp-private/erp-public/erp-temp — создаёт s3-init) ----
# Этот же ключ используют CRM, Langfuse и ERP (файлы ERP — только здесь, на диск контейнера они не пишутся).
S3_ACCESS_KEY=rt
S3_SECRET_KEY=CHANGE_ME

# --- LiteLLM — единственный шлюз к моделям (ADR-0005) --------------------------------------
# Мастер-ключ прокси (api/worker CRM ходят с ним; ERP — своим ключом ниже). Должен начинаться с "sk-".
LITELLM_MASTER_KEY=sk-CHANGE_ME
# Ключ шифрования ключей провайдеров в БД LiteLLM. НЕ МЕНЯТЬ после первого запуска:
# ключи, введённые в консоли админа CRM, станут нечитаемыми. Хранить вместе с бэкапом .env.
LITELLM_SALT_KEY=sk-CHANGE_ME
# Ключи провайдеров по умолчанию — только сервису litellm; ключ из консоли CRM имеет приоритет.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- docling-serve (конвертация документов базы знаний CRM) ---------------------------------
DOCLING_API_KEY=CHANGE_ME

# --- CRM (apps/crm): аутентификация и секреты ------------------------------------------------
# Ключ подписи access-JWT CRM (HS256, ≥ 32 байт). Смена разлогинивает всех.
CRM_JWT_SECRET=CHANGE_ME
# Ключ шифрования секретов интеграций в БД CRM (Fernet, ≥ 32 символов). Потеря = ввод токенов заново.
CRM_SECRETS_KEY=CHANGE_ME
# HMAC-ключ контекста вызова MCP-инструментов агентов CRM.
CRM_AGENT_CONTEXT_KEY=CHANGE_ME
# Ключи проекта Langfuse для трейсов CRM (создать в Langfuse после первого входа). Пусто — трейсов нет.
CRM_LANGFUSE_PUBLIC_KEY=
CRM_LANGFUSE_SECRET_KEY=

# --- Telegram: один клиентский бот, принадлежит CRM --------------------------------------------
# Токен от @BotFather. На dev — отдельный тестовый бот. Пусто — бот не запускается.
TELEGRAM_BOT_TOKEN=
# Имя того же бота без @ (не секрет): Cabinet строит ссылки t.me/<бот>?start=web, «Написать менеджеру»
# t.me/<бот>?start=deal_<id> (M2-CAB-03) и Mini App (M2-CAB-01). Пусто — эти кнопки скрыты.
TELEGRAM_BOT_USERNAME=
# polling (dev) | webhook (prod) | disabled
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME
# Адрес Bot API. Пусто — api.telegram.org. Заглушка на стенде без токена (docs/runbooks/crm-bot.md): http://fake-bot-api:8081
TELEGRAM_API_BASE_URL=

# --- Cabinet ↔ CRM: форма «Я новый клиент» на странице входа Cabinet (M2-CAB-03) ---------------
# Адрес CRM, куда Cabinet отправляет форму (build-arg VITE_CRM_URL образа cabinet-web, не секрет).
# Пусто — http://crm.localhost:${HTTP_PORT} (dev); prod — https://crm.railtech.uz.
CABINET_CRM_URL=
# Origin Cabinet, которым CRM разрешает CORS на /api/v1/leads/web* (через запятую, точное сравнение
# со схемой и портом). Пусто — http://cabinet.localhost, http://cabinet.localhost:${HTTP_PORT} и
# https://${CABINET_DOMAIN}.
CABINET_ORIGIN=
# SameSite cookie сессии портала (ERP). Lax — веб Cabinet; None — Telegram Mini App (Cabinet во фрейме
# Telegram — другой сайт), cookie получает Secure и работает только за TLS. На стенде http — оставить Lax.
PORTAL_COOKIE_SAMESITE=Lax

# --- Шов CRM ↔ ERP (CONTRACTS §0, §3, §5, §6) — используются с M3 ------------------------------
# Обязательны: значений по умолчанию в коде нет (FIX-01), compose без них не поднимет стенд.
# Сервисные токены по направлению; два активных значения через запятую для ротации без простоя.
# CRM берёт сервисный токен и секрет вебхуков из «Подключений» → ERP — введите там те же значения.
SERVICE_TOKEN_CRM_TO_ERP=CHANGE_ME
SERVICE_TOKEN_ERP_TO_CRM=CHANGE_ME
# HMAC вебхуков ERP → CRM (в ERP — ERP_WEBHOOK_SECRET). ERP подписывает этим секретом.
WEBHOOK_SECRET=CHANGE_ME
# Ротация без простоя (FIX-35, docs/runbooks/webhooks.md): пусто в обычное время. Во время смены — прежний секрет;
# в CRM («Подключения» → ERP) вводятся оба: новый как текущий и прежний как «предыдущий» (CRM принимает оба), затем
# предыдущий снимается. Допустимо вместо этого записать оба через запятую в WEBHOOK_SECRET: подписывает первый.
WEBHOOK_SECRET_PREVIOUS=
# Общий секрет SSO-токена сотрудника (packages/contracts/sso-token.md).
PLATFORM_SSO_SECRET=CHANGE_ME
# Переход сотрудника CRM ↔ ERP без пароля (FIX-03). Включать только после FIX-10 и FIX-11: true/false.
PLATFORM_SSO_ENABLED=false
# HMAC контекста X-Agent-Context для erp-mcp.
ERP_MCP_CONTEXT_KEY=CHANGE_ME

# --- ERP (apps/erp) ------------------------------------------------------------------------------
# Имя продукта и поддержка — бренд как настройка (DECISIONS 2026-10-13).
PLATFORM_NAME=RailTech Platform
# Id компании-владельца ERP (core.tenant). Пусто — автоопределение: единственный продавец с активными
# сотрудниками; на проде и при нескольких продавцах — обязательна (FIX-11, Q-FIX11).
OWN_COMPANY_ID=
SUPPORT_EMAIL=support@example.com
# Django SECRET_KEY ERP (≥ 50 символов).
ERP_SECRET_KEY=CHANGE_ME
# dev: true (CORS/CSRF для localhost в коде B2B включаются по DEBUG); prod: false.
ERP_DEBUG=true
# Почта ERP на dev — в консоль контейнера; prod — SMTP-релей (ARCHITECTURE §18, M3-CRM-08 / M5).
ERP_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# ИИ ERP (M1-ERP-06): только через общий LiteLLM по алиасам intake/match/draft/enrich-model.
# Виртуальный ключ ERP — генерирует make env; сервис erp-ai-gateway регистрирует его в LiteLLM с
# дневным бюджетом и трейсами Langfuse. Пусто — ERP ходит мастер-ключом (без бюджета шлюза и трейсов).
ERP_LITELLM_API_KEY=sk-CHANGE_ME
# Бюджет ИИ ERP на день, USD (журнал ERP + бюджет ключа в шлюзе); 0 — без лимита. Как erp_daily_usd в CRM.
ERP_AI_DAILY_BUDGET_USD=1
# Ключи проекта Langfuse для трейсов ERP (их пишет шлюз). Пусто — берутся CRM_LANGFUSE_* (общий проект).
ERP_LANGFUSE_PUBLIC_KEY=
ERP_LANGFUSE_SECRET_KEY=

# --- Платформа (apps/platform, INF-P0-4) ------------------------------------------------------------------
# Время жизни сессии сотрудника в Redis, часы (целое ≥ 1). По умолчанию 12 — как в apps/platform/bff/app/config.py.
# Новых секретов у Платформы нет: сессия — случайный идентификатор в Redis, URL CRM/ERP и Redis задаёт compose.
PLATFORM_SESSION_TTL_HOURS=12
# Вход сотрудника в BFF (необязательно, не секреты; Q-PLT-10-1 п. 5). Значения по умолчанию — ниже.
# Secure у cookie сессии: в коде по умолчанию true, но стенд ходит по http, и Safari Secure-cookie по http не примет,
# поэтому dev.yml для стенда ставит false. На проде (prod.yml) всегда true. Включить на стенде — раскомментируйте true.
# PLATFORM_COOKIE_SECURE=false
# Имя refresh-cookie ERP (REFRESH_COOKIE_NAME в ERP).
# PLATFORM_ERP_REFRESH_COOKIE=refresh_token
# Попыток входа в минуту — отдельно на IP и на e-mail.
# PLATFORM_LOGIN_RATE_PER_MINUTE=10

# --- Caddy / порты dev ----------------------------------------------------------------------------
# Порт HTTP на хосте: crm.localhost, erp.localhost, cabinet.localhost открываются через него.
HTTP_PORT=80
# Публичные адреса трёх систем для переходов SSO и ссылок в письмах. Пусто — http://<система>.localhost:${HTTP_PORT}
# (на стенде), на проде — https://домены из DOMAIN-переменных.
ERP_FRONTEND_URL=
CRM_FRONTEND_URL=
CABINET_URL=
# Прямой доступ к сервисам на 127.0.0.1 (меняйте, если порт занят другим проектом).
DEV_POSTGRES_PORT=5432
DEV_REDIS_BROKER_PORT=6379
DEV_REDIS_CACHE_PORT=6380
DEV_S3_PORT=9000
DEV_S3_CONSOLE_PORT=9001
DEV_LITELLM_PORT=4000
DEV_CRM_API_PORT=8000
DEV_ERP_API_PORT=8010
DEV_LANGFUSE_PORT=3000
DEV_CLICKHOUSE_PORT=8123

# --- prod: домены и ACME (M5-INF-01) ----------------------------------------------------------------
CRM_DOMAIN=crm.railtech.uz
ERP_DOMAIN=erp.railtech.uz
CABINET_DOMAIN=cabinet.railtech.uz
ACME_EMAIL=admin@example.com

# --- Langfuse (профиль observability: make up-obs) ---------------------------------------------------
LANGFUSE_URL=http://langfuse.localhost
LANGFUSE_S3_PUBLIC_ENDPOINT=http://s3.localhost
# openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME
LANGFUSE_SALT=CHANGE_ME
# ровно 64 hex-символа: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME
CLICKHOUSE_PASSWORD=CHANGE_ME
