# Корень монорепозитория RailTech Platform. У приложений свои .gitignore (apps/*/, legacy/b2b/).

# Секреты и локальное окружение — только в окружении (ORCHESTRATOR §3.6)
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
.venv-tools/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Node
node_modules/
dist/
coverage/
*.local

# ОС и редакторы
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
*.log

# Claude Code: локальные настройки и рабочие копии агентов
.claude/settings.local.json
.claude/worktrees/

# Локальный CI и отчёты
.ci-local/

# Публичные CA-сертификаты ERP для синка ТН ВЭД (не секрет; правило *.pem выше их отсекало)
!apps/erp/backend/master_data/certs/*.pem
