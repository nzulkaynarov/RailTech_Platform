#, python-format
msgid "Вы запросили вход в личный кабинет компании «%(company)s» на платформе %(platform)s."
msgstr "Siz %(platform)s platformasida «%(company)s» kompaniyasining shaxsiy kabinetiga kirishni soʻradingiz."

