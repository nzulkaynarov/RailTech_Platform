# dev: http://localhost без TLS (SPEC §14).
{
	auto_https off
}

:80 {
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}
	handle /ready {
		reverse_proxy api:8000
	}
	handle {
		# Экранов CRM больше нет (снос старых фронтов, 2026-11-11): интерфейс сотрудника — Платформа.
		respond 404
	}
}
