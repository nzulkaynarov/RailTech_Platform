# prod: TLS через ACME, HSTS. IP allow-list для Langfuse/консоли RustFS и
# security headers — Фаза 8 (PLAN.md).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /telegram/webhook {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}
	handle /ready {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:8080
	}
}
