# RailTech CRM — переменные окружения.
# Скопируйте в .env (это делает scripts/bootstrap_dev.sh) и заполните.
# Значения CHANGE_ME bootstrap_dev.sh заменяет случайными. Реальные секреты
# в репозиторий не коммитятся (CLAUDE.md §2.6). Читает их только app/config.py
# (backend) и docker compose (инфраструктура).

# --- Приложение ---------------------------------------------------------------
# Окружение: dev | prod | test. Влияет на режимы (polling/webhook и т. п.).
APP_ENV=dev
# Уровень логов: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
# Формат логов: json (по умолчанию, для docker logs/Loki) | console (читаемый, локально).
LOG_FORMAT=json
# Таймаут одной проверки GET /ready, секунды.
READY_CHECK_TIMEOUT_S=2

# --- PostgreSQL 17 + pgvector ---------------------------------------------------
# Хост/порт внутри compose задаются в docker-compose.yml (postgres:5432).
# Имя базы приложения (домен, векторы, очередь, чекпоинты).
POSTGRES_DB=railtech
# Пользователь БД приложения.
POSTGRES_USER=railtech
# Пароль пользователя БД.
POSTGRES_PASSWORD=CHANGE_ME

# --- S3-хранилище: RustFS (ADR-0009) -----------------------------------------------
# Root-учётка RustFS (вход в консоль http://localhost:9001 на dev, создание бакетов).
# Приложению отдельные ключи выдаются с Фазы 1.
S3_ACCESS_KEY=railtech
S3_SECRET_KEY=CHANGE_ME

# --- LiteLLM Proxy ------------------------------------------------------------------
# Мастер-ключ прокси (доступ api/worker к шлюзу). Должен начинаться с "sk-".
LITELLM_MASTER_KEY=sk-CHANGE_ME
# Ключ шифрования ключей провайдеров в БД LiteLLM (ADR-0020; модели и ключи меняются из CRM).
# Генерируется bootstrap_dev.sh. НЕ МЕНЯТЬ после первого запуска: ключи, введённые в CRM,
# станут нечитаемыми — их придётся ввести заново. Хранить вместе с бэкапом .env.
LITELLM_SALT_KEY=sk-CHANGE_ME
# Ключи провайдеров моделей по умолчанию (ADR-0004, ADR-0020). Передаются только сервису litellm;
# ключ, введённый в CRM («Модели ИИ»), имеет приоритет для своей роли.
# Anthropic: dialog-model, qualifier-model, judge-model. Получить: console.anthropic.com
ANTHROPIC_API_KEY=
# Google Gemini API: embed-model и fallback-model. Получить: aistudio.google.com
GEMINI_API_KEY=

# --- docling-serve (конвертация документов KB, ADR-0011) ------------------------
# Ключ доступа worker → docling (внутренняя сеть).
DOCLING_API_KEY=CHANGE_ME

# --- CRM: аутентификация (SPEC §11, ADR-0005) -------------------------------------
# Ключ подписи access-JWT (HS256, ≥ 32 байт). Смена ключа разлогинивает всех.
JWT_SECRET=CHANGE_ME
# Ключ шифрования секретов интеграций в БД (токен бота из «Подключений», Fernet).
# ≥ 32 символов: `openssl rand -hex 32` (bootstrap_dev.sh генерирует сам). В бэкап БД не
# попадает — храните отдельно. Потеря/смена ключа: сохранённый токен не расшифруется,
# бот вернётся к TELEGRAM_BOT_TOKEN, токен нужно ввести в «Подключениях» заново.
SECRETS_KEY=CHANGE_ME

# --- Агенты ------------------------------------------------------------------------
# HMAC-ключ подписи контекста вызова MCP-инструментов (SPEC §7.1, ADR-0008).
AGENT_CONTEXT_KEY=CHANGE_ME

# --- Telegram (клиентский бот, SPEC §9.2) ----------------------------------------
# Токен бота от @BotFather. На dev — отдельный dev-бот. Пусто — бот не запускается.
TELEGRAM_BOT_TOKEN=
# Режим: polling (dev, без публичного URL) | webhook (prod) | disabled.
TELEGRAM_MODE=polling
# prod: публичный URL webhook, например https://crm.example.com/telegram/webhook.
TELEGRAM_WEBHOOK_URL=
# prod: secret_token webhook (A-Z, a-z, 0-9, _ и -; до 256 символов).
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME

# --- ERP (коннектор бэк-офиса, ADR-0022, ADR-0018; настраивается в «Подключениях» → «ERP») ----
# Запасные значения на случай, если коннектор не задан из CRM: адрес и секреты из «Подключений»
# (БД) имеют приоритет. Корень ERP, например https://erp.example.com — путь /api/integration/v1
# CRM добавляет сама. Пусто — коннектор не настроен: «Сделать клиентом» и итоги сделок работают
# в CRM как прежде.
ERP_BASE_URL=
# Сервисный токен CRM→ERP (CONTRACTS §0, `Authorization: Bearer`).
ERP_SERVICE_TOKEN=
# Секрет подписи вебхуков ERP→CRM (CONTRACTS §3, `X-Signature`); приёмник событий — M3-CRM-04.
ERP_WEBHOOK_SECRET=
# Общий с ERP секрет SSO-токена сотрудника (packages/contracts/sso-token.md, HS256); два значения
# через запятую — ротация. Значения по умолчанию нет: пусто — переход CRM ↔ ERP выключен,
# при APP_ENV=prod — CRM не стартует.
PLATFORM_SSO_SECRET=
# Адрес SPA ERP для перехода по SSO.
ERP_FRONTEND_URL=http://erp.localhost

# --- Почта (коннектор «Почта», M3-CRM-08, ADR-0018; настраивается в «Подключениях» → «Почта») ----
# Запасные значения на случай, если коннектор не задан из CRM: настройки и секреты из
# «Подключений» (БД) имеют приоритет. SMTP-релей транзакционного провайдера (ARCHITECTURE §18),
# письма только сотрудникам: приглашение, сброс пароля. Пусто — коннектора нет: письма не уходят
# (в журнале `skipped_no_smtp`), админ выдаёт временный пароль вручную, как прежде.
SMTP_HOST=
SMTP_PORT=587
# starttls (587) | ssl (465) | none (только внутри сети).
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Адрес и имя отправителя; домен — с SPF/DKIM/DMARC у провайдера.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
# --- Cabinet (форма «Запрос» на странице входа, M3-CRM-05) ------------------------------
# Origin страницы входа Cabinet, которой разрешено вызывать публичную форму
# POST /api/v1/leads/web (CORS только на /api/v1/leads/web*, не на весь API). Несколько — через
# запятую.
# Сравнение точное, со схемой и портом: при HTTP_PORT≠80 добавьте http://cabinet.localhost:<порт>.
# Пусто — CORS выключен. В ансамбле (infra/compose) значение по умолчанию задаёт compose.
# dev: http://cabinet.localhost, prod: https://cabinet.railtech.uz
CABINET_ORIGIN=http://cabinet.localhost

# --- Caddy ------------------------------------------------------------------------
# dev: порт на localhost, через который открывается CRM (http://localhost:80).
HTTP_PORT=80
# dev: порты на 127.0.0.1 для прямого доступа к сервисам. Меняйте, если порт занят
# другим проектом (например, DEV_API_PORT=8001, DEV_POSTGRES_PORT=5433).
DEV_API_PORT=8000
DEV_POSTGRES_PORT=5432
DEV_S3_PORT=9000
DEV_S3_CONSOLE_PORT=9001
DEV_LITELLM_PORT=4000
DEV_LANGFUSE_PORT=3000
DEV_CLICKHOUSE_PORT=8123
# prod: домен CRM и email для ACME (Let's Encrypt). В dev не используются.
DOMAIN=crm.example.com
ACME_EMAIL=admin@example.com
# prod: поддомены админских интерфейсов (по умолчанию langfuse.<DOMAIN>, s3.<DOMAIN>)
# и IP allow-list для них — CIDR через пробел (ваш офис/VPN).
LANGFUSE_DOMAIN=
S3_CONSOLE_DOMAIN=
ADMIN_ALLOW_CIDRS=203.0.113.10/32

# --- prod-образы (Фаза 8) ------------------------------------------------------------
# Реестр и тег образов: git sha, scripts/deploy.sh записывает сам (пусто до первой выкладки).
IMAGE_REGISTRY=ghcr.io/nzulkaynarov
IMAGE_TAG=

# --- Бэкапы (сервис backup, ADR-0013) ------------------------------------------------
# Хранить дней; время ежедневного бэкапа в UTC (22:00 UTC = 03:00 Asia/Tashkent).
BACKUP_KEEP_DAYS=14
BACKUP_AT_UTC=22:00

# --- Langfuse (профиль observability: make up-obs) ------------------------------
# Публичный URL Langfuse (NEXTAUTH_URL).
LANGFUSE_URL=http://localhost:3000
# Публичный адрес S3 (RustFS) для загрузки медиа из браузера.
LANGFUSE_S3_PUBLIC_ENDPOINT=http://localhost:9000
# Секрет NextAuth (openssl rand -base64 32).
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME
# Соль для хэширования API-ключей Langfuse.
LANGFUSE_SALT=CHANGE_ME
# Ключ шифрования данных Langfuse: ровно 64 hex-символа (openssl rand -hex 32).
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME
# Пароль ClickHouse (хранилище трейсов Langfuse).
CLICKHOUSE_PASSWORD=CHANGE_ME
# Пароль Redis (очереди Langfuse; приложением не используется).
REDIS_AUTH=CHANGE_ME
# Ключи проекта Langfuse для трейсов приложения: создать в UI Langfuse
# (Settings → API Keys) после первого входа. Пусто — трейсы не отправляются.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
