# RailTech CRM — переменные окружения.
# Скопируйте в .env (это делает scripts/bootstrap_dev.sh) и заполните.
# Значения CHANGE_ME bootstrap_dev.sh заменяет случайными. Реальные секреты
# в репозиторий не коммитятся (CLAUDE.md §2.6). Читает их только app/config.py
# (backend) и docker compose (инфраструктура).

# --- Приложение ---------------------------------------------------------------
# Окружение: dev | prod | test. Влияет на режимы (polling/webhook и т. п.).
APP_ENV=dev
# Уровень логов: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
# Формат логов: json (по умолчанию, для docker logs/Loki) | console (читаемый, локально).
LOG_FORMAT=json
# Таймаут одной проверки GET /ready, секунды.
READY_CHECK_TIMEOUT_S=2

# --- PostgreSQL 16 + pgvector ---------------------------------------------------
# Хост/порт внутри compose задаются в docker-compose.yml (postgres:5432).
# Имя базы приложения (домен, векторы, очередь, чекпоинты).
POSTGRES_DB=railtech
# Пользователь БД приложения.
POSTGRES_USER=railtech
# Пароль пользователя БД.
POSTGRES_PASSWORD=CHANGE_ME

# --- S3-хранилище: RustFS (ADR-0009) -----------------------------------------------
# Root-учётка RustFS (вход в консоль http://localhost:9001 на dev, создание бакетов).
# Приложению отдельные ключи выдаются с Фазы 1.
S3_ACCESS_KEY=railtech
S3_SECRET_KEY=CHANGE_ME

# --- LiteLLM Proxy ------------------------------------------------------------------
# Мастер-ключ прокси (доступ api/worker к шлюзу). Должен начинаться с "sk-".
LITELLM_MASTER_KEY=sk-CHANGE_ME
# Ключи провайдеров моделей добавляются в Фазе 1 (ADR-0004) и видны только litellm.

# --- Caddy ------------------------------------------------------------------------
# dev: порт на localhost, через который открывается CRM (http://localhost:80).
HTTP_PORT=80
# prod: домен CRM и email для ACME (Let's Encrypt). В dev не используются.
DOMAIN=crm.example.com
ACME_EMAIL=admin@example.com

# --- Langfuse (профиль observability: make up-obs) ------------------------------
# Публичный URL Langfuse (NEXTAUTH_URL).
LANGFUSE_URL=http://localhost:3000
# Публичный адрес S3 (RustFS) для загрузки медиа из браузера.
LANGFUSE_S3_PUBLIC_ENDPOINT=http://localhost:9000
# Секрет NextAuth (openssl rand -base64 32).
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME
# Соль для хэширования API-ключей Langfuse.
LANGFUSE_SALT=CHANGE_ME
# Ключ шифрования данных Langfuse: ровно 64 hex-символа (openssl rand -hex 32).
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME
# Пароль ClickHouse (хранилище трейсов Langfuse).
CLICKHOUSE_PASSWORD=CHANGE_ME
# Пароль Redis (очереди Langfuse; приложением не используется).
REDIS_AUTH=CHANGE_ME
