{
  "name": "cabinet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cabinet — кабинет клиента RailTech Platform: SPA без бэкенда, ходит в ERP /api/portal/v1 (ADR-0004); Telegram Mini App и веб",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api-types": "openapi-typescript ../../packages/contracts/openapi/erp-portal.yaml -o src/api/portal.d.ts && node scripts/gen-crm-form-types.mjs > src/api/crm-form.d.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.8",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^15.11.0",
    "jsdom": "^23.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.9",
    "vitest-axe": "1.0.0-pre.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.59.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
