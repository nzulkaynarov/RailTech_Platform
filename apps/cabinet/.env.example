# Cabinet — только VITE_*-переменные без секретов (docs/systems/cabinet/CONVENTIONS.md §2.8). Токен бота Cabinet не знает.
# Скопируйте в .env.local для dev; в образе (infra/compose/base.yml) значения приходят build-аргументами.

# База API: пустая строка = same-origin (/api/portal/v1 проксирует Caddy на ERP с домена cabinet.*).
VITE_API_URL=
# 1 — мок портального API на MSW из src/mocks (только dev-сборка; в прод-сборку не попадает).
# make dev включает его сам, make dev-stand — выключает.
VITE_PORTAL_MOCK=1
# Имя клиентского бота CRM без @: «Написать в Telegram» → https://t.me/<бот>?start=web, «Войти через Telegram»,
# «Написать менеджеру» → https://t.me/<бот>?start=deal_<id> (M2-CAB-03).
# В ансамбле — TELEGRAM_BOT_USERNAME из корневого .env. Пусто — кнопки скрыты.
VITE_BOT_USERNAME=railtech_bot
# CRM для формы «Я новый клиент» (GET/POST /api/v1/leads/web*, без секретов). CRM пускает только origin
# из своего CABINET_ORIGIN (CORS). Пусто в dev-сервере — тот же origin (make dev: мок MSW, make dev-stand:
# прокси Vite на VITE_CRM_PROXY_TARGET); пусто в сборке — вместо формы «Написать в Telegram».
# Стенд: http://crm.localhost:<HTTP_PORT> (в ансамбле — CABINET_CRM_URL корневого .env), прод: https://crm.railtech.uz
VITE_CRM_URL=

# Не попадает в сборку: цель прокси dev-сервера Vite для /api/portal при make dev-stand
# (читается из окружения shell, по умолчанию http://erp.localhost — стенд ансамбля).
# VITE_PORTAL_PROXY_TARGET=http://erp.localhost
# То же для формы лида в make dev-stand: /api/v1/leads/web → CRM стенда.
# VITE_CRM_PROXY_TARGET=http://crm.localhost
